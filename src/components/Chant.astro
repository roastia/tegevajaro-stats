---
// チャント1件（コンパクト）：1行目＝背番号・名前・コール、2行目＝原曲、右に「聴く」
// 選手名は黒で、Jリーグ公式の選手ページへのリンク（link）
// rec：ブーゲンビリーバー以外の録音のときだけ、その出どころを小さく書く
import { siteUrl, icon } from '../lib/util.js';
interface Props { label?: string; name?: string; link?: string; tag?: string; call?: string; song?: string; artist?: string; youtube?: string; rec?: string }
const { label, name, link, tag, call, song, artist, youtube, rec } = Astro.props;
// 原曲の曲名がわからずアーティストだけわかるときは、アーティストだけ出す
const orig = song ? (artist ? `${song}（${artist}）` : song) : (artist ?? '');
const url = youtube ? siteUrl(youtube) : '';
---
<li class="chant">
  {(name || call) && (
    <p class="chant-who">
      {tag && <span class="chant-no">{tag}</span>}
      {name && <span class="chant-name">{link ? <a class="pl-link" href={link} target="_blank" rel="noopener noreferrer">{name}</a> : name}</span>}
      {call && <span class="chant-call"><span class="chant-lb">コール</span>{call}</span>}
    </p>
  )}
  {orig && <p class="chant-song"><span class="chant-lb">原曲</span>{orig}</p>}
  {rec && url && <p class="chant-song"><span class="chant-lb">音源</span>{rec}</p>}
  {url && <a class="chant-play" href={url} target="_blank" rel="noopener noreferrer" aria-label={`${label ?? name ?? ''}のチャントを聴く（YouTube）`}><Fragment set:html={icon('play')} />聴く</a>}
</li>
