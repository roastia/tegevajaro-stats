---
// 画像のように見せるカード（ポスト用画像と同じデザイン）
import { icon, href } from '../lib/util.js';
import { CHARS } from '../lib/meta.js';
import { SITE } from '../config/site.js';
interface Props { item: any; char?: string; tag?: string }
const { item, char = 'ace', tag = 'div' } = Astro.props;
const ch = CHARS[char];
const Tag = tag;
const kicker = item.kind === 'r' ? `ランキング｜${item.label}` : item.label;
const headline = item.kind === 'r' ? `${item.label} 1位` : item.headline;
---
<Tag class="shot">
  <span class="char" aria-hidden="true">{ch && ch.img ? <img src={href(ch.img)} alt="" width="56" height="56" /> : <Fragment set:html={icon(item.icon)} />}</span>
  <div class="lb"><Fragment set:html={icon(item.icon)} />{kicker}</div>
  <div class="hl">{headline}</div>
  <div class="bg">{item.big}</div>
  {item.sub && <div class="sb">{item.sub}</div>}
  {item.top && item.top.length > 1 && <div class="sb">{item.top.slice(1).map(t => `${t.rank}位 ${t.name}`).join('　')}</div>}
  {item.cheer && <div class="ch">{item.cheer}</div>}
  <div class="ft"><span>{SITE.short}</span><span>{SITE.roundLabel}時点</span></div>
</Tag>
