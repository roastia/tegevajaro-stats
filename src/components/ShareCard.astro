---
import Shot from './Shot.astro';
import PostBox from './PostBox.astro';
import { SITE } from '../config/site.js';
import { CHAR_OF_TOPIC, CHAR_OF_RECORD } from '../lib/meta.js';
import { sharePath } from '../lib/data.js';
interface Props { item: any }
const { item } = Astro.props;
const char = item.kind === 'r' ? CHAR_OF_RECORD[item.id] : CHAR_OF_TOPIC[item.id];
---
<article class="share reveal" id={`${item.kind}-${item.id}`}>
  <Shot item={item} char={char} />
  <PostBox what={item.label} text={item.text} url={`${SITE.url}/${sharePath(item)}`} />
</article>
