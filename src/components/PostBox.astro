---
// どのデータのポストかがわかるボタン＋ポスト文のプレビュー
import { xIntent, X_MARK } from '../lib/util.js';
interface Props { what: string; text: string; url?: string }
const { what, text, url } = Astro.props;
---
<div class="post">
  <a class="postbtn" href={xIntent(text, url)} target="_blank" rel="noopener noreferrer">
    <Fragment set:html={X_MARK} /><span><b>「{what}」</b>をXでポスト</span>
  </a>
  <details class="postprev">
    <summary>ポストする文章を見る</summary>
    <p>{text}{url ? '\n' + url : ''}</p>
  </details>
</div>
