---
import '../styles/global.css';
import { clubUrl } from '../config/clubs.js';
import { SITE } from '../config/site.js';
import { getData } from '../lib/data.js';
import { icon, href, playerUrl } from '../lib/util.js';
import { seasonRecord } from '../lib/form.js';
import { readCsv } from '../lib/data.js';
import { nextMatch } from '../lib/nextmatch.js';

interface Props { title?: string; description?: string; image?: string; path?: string; current?: string }
const { title, description, image = 'og/site.png', path = '', current = '' } = Astro.props;
// 検索結果のタイトル：ページ名｜テゲバジャーロ宮崎｜テゲスタ！（トップはサイト名＋説明）
const fullTitle = title ? `${title}｜${SITE.team}｜${SITE.short}` : `${SITE.name} ${SITE.team}のスタッツ・ランキング（非公式サポーターサイト）`;
const desc = description || `${SITE.team}の今季の記録から作った、テゲサポが語りたくなるランキングと注目トピック。直近5試合の成績・選手の称号・試合ハイライトも（非公式サポーターサイト）。${SITE.roundLabel}時点。`;
// canonical は各ページ自身の URL（path を渡さないページは、開いている URL から決める）
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const selfPath = path || Astro.url.pathname.slice(base.length).replace(/^\//, '');
const pageUrl = SITE.url + '/' + selfPath;
// 構造化データ（検索エンジン向けのサイト名・パンくず）
const ld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, alternateName: [`${SITE.name} ${SITE.tagline}`, 'テゲスタ', SITE.tagline], url: SITE.url + '/', inLanguage: 'ja', description: desc }];
if (title) ld.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url + '/' },
  { '@type': 'ListItem', position: 2, name: title, item: pageUrl } ] });
const imageUrl = SITE.url + '/' + image;
const d = getData();
const sr = seasonRecord(d.matches);
// 次の試合（今季の成績の横）：ビルド時点の表示を入れておき、ブラウザで日本時間の今に合わせて書き換える（site.js）
const fixtures = readCsv('fixtures');
const lite = d.matches.map(m => ({ round: m.round, opponent: m.opponent, gf: m.gf, ga: m.ga, result: m.result }));
const nx = nextMatch(fixtures, lite);
const nxWhen = nx ? `${nx.tag}・${nx.when.replace(' キックオフ', '')}` : '';
// 誕生日はブラウザ側で「今日」から数えるので、必要な項目だけ渡す
const bdays = d.profiles.filter(p => p.birth).map(p => ({ no: p.no, name: p.name, pos: p.pos, birth: p.birth }));
const nav = [
  ['', 'topics', '注目トピック'], ['ranking/', 'ranking', 'ランキング'], ['players/', 'players', '選手'],
  ['goals/', 'goals', 'ハイライト'], ['schedule/', 'schedule', '日程'],
  ['spots/', 'spots', 'みやざき情報'],
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={pageUrl} />
  <meta name="theme-color" content="#C8375F" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(ld).replace(/</g, '\\u003c')}></script>
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content={`${SITE.name} ${SITE.tagline}`} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
</head>
<body>
  <script type="application/json" id="pl-urls" is:inline set:html={JSON.stringify(Object.fromEntries(d.players.map(p => [p.name, playerUrl(p.jl_url)]).filter(([, u]) => u))).replace(/</g, '\\u003c')}></script>
  <header class="site-head">
    <div class="wrap">
      <h1><a href={href('')} class="logo-link"><img class="logo" src={href('logo-tegesta.svg')} alt={SITE.name} width="1731" height="388" /></a><span class="head-sub"><span class="tagline">{SITE.tagline}</span><span class="unofficial">非公式サポーターサイト</span></span></h1>
      <section class="season" aria-label="今季の成績">
        <div class="season-h"><span class="season-k">今季の成績</span><span class="season-when">J2 {SITE.roundLabel}時点（{SITE.lastMatch}まで）</span></div>
        <div class="season-rec">
          {SITE.rank && <a class="rank rank-link" href="https://www.jleague.jp/standings/j2/" target="_blank" rel="noopener noreferrer" aria-label={`J2 ${SITE.rank}位${SITE.rankPending ? '（暫定）' : ''}（Jリーグ公式のJ2順位表を開く）`}>J2<b>{SITE.rank}</b>位{SITE.rankPending && <small class="rank-tmp">暫定</small>}</a>}
          <span class="wdl"><b>{sr.w}</b>勝<b>{sr.d}</b>分<b>{sr.l}</b>敗</span>
          <span class="pts">勝ち点<b>{sr.pts}</b></span>
          <span class="gl">{sr.gf}得点・{sr.ga}失点（{sr.gd > 0 ? '+' : ''}{sr.gd}）</span>
        </div>
        {nx && (
          <div class="season-next" id="seasonNext" data-mode={nx.mode}>
            <script type="application/json" id="next-data" is:inline set:html={JSON.stringify({ fixtures, matches: lite }).replace(/</g, '\\u003c')}></script>
            <div class="season-h"><span class="season-k">次の試合</span><span class="season-when" data-sn="when">{nxWhen}</span></div>
            <div class="sn-row">
              <span class="sn-vs"><span class={`sn-ha ${nx.fx.ha === 'H' ? 'h' : 'a'}`} data-sn="ha">{nx.fx.ha === 'H' ? 'ホーム' : 'アウェイ'}</span><span>vs <a class="club-link" data-sn="club" href={clubUrl(nx.fx.opponent_full) || clubUrl(nx.fx.opponent) || undefined} target="_blank" rel="noopener noreferrer">{nx.vs.replace(/戦$/, '')}</a></span></span>
              <span class="sn-count">
                <span class="sn-big" data-sn="big">{nx.big}</span>
                <span class="sn-board" data-sn="board" hidden></span>
              </span>
            </div>
          </div>
        )}
      </section>
    </div>
  </header>
  <span class="navtop" aria-hidden="true"></span>
  <nav class="site-nav" aria-label="ページ">
    <ul>
      {nav.map(([p, id, label]) => <li><a class={id === 'spots' ? 'nw nav-miya' : 'nw'} href={href(p)} data-astro-prefetch="viewport" aria-current={current === id ? 'page' : undefined}>{label}</a></li>)}
    </ul>
  </nav>
  <div class="wrap">
    <section class="hbd" id="hbd" hidden aria-live="polite"></section>
  </div>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site-foot">
    <div class="wrap">
      <p>このサイトは個人が運営する<b>非公式のサポーターサイト</b>です。テゲバジャーロ宮崎、Jリーグ、各データ提供元とは関係ありません。ランキングは公開データをもとに独自に集計したもので、公式記録ではありません。広告・収益化はしていません。</p>
      <p>選手の写真・クラブのエンブレムは使用していません。選手名からJリーグ公式の選手ページへリンクしています。</p>
      <p>出典</p>
      <ul>
        <li><a href="https://www.jleague.jp/" rel="noopener noreferrer" target="_blank">Jリーグ公式サイト</a>（試合結果・出場記録・選手情報・公式ハイライト・スタメンとフォーメーション）</li>
        {SITE.footballLab && <li><a href="https://www.football-lab.jp/" rel="noopener noreferrer" target="_blank">Football LAB</a> ©DataStadium Inc.（シュート・ラストパス・ゴール期待値・プレー指標・パス交換）</li>}
        <li>各メディア・クラブ公式サイト（得点時間・経歴の補足、スポーツナビの選手名のよみ、観戦ガイド・アクセス、試合日程）</li>
        <li>テゲサポのみなさん（おすすめスポットの情報）</li>
      </ul>
      <p>データ時点：{SITE.roundLabel}（{SITE.asOf}）・<a href={href('updates/')}>更新履歴</a></p>
    </div>
  </footer>
  <script type="application/json" id="bday-data" is:inline set:html={JSON.stringify(bdays).replace(/</g, '\\u003c')}></script>
  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
