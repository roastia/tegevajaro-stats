[
 {"id": "k1", "no": 2, "date": "2026-11-01", "time": "21:03", "nickname": "見本のテゲ太郎", "body": "はじめてテゲスタに行った日、ゴール裏の声に鳥肌が立ちました。\nそれから毎試合、家族で通っています。勝った日の帰り道に食べるチキン南蛮が最高です！", "tags": ["応援", "スタジアム", "家族・仲間"]},
 {"id": "k2", "no": 3, "date": "2026-11-01", "time": "22:15", "nickname": "", "body": ">>2\nわかる！チキン南蛮まで含めて試合ですよね。\n最後まであきらめない姿勢がテゲバらしくて大好きです。", "tags": ["選手"]},
 {"id": "k3", "no": 4, "date": "2026-11-02", "time": "07:41", "nickname": "見本のみやざきの風", "body": "アウェイ遠征で出会ったテゲサポのみなさんがあたたかくて、ひとりで行っても全然さみしくなかった。どこに行っても宮崎の話で盛り上がれる。\n\n来年も再来年も、テゲバと一緒に夢を見たい。", "tags": ["遠征", "思い出", "未来"]},
 {"id": "k4", "no": 5, "date": "2026-11-03", "time": "12:15", "nickname": "", "body": ">>2 >>4\nふたりとも最高。今度テゲスタで会いましょう！", "tags": ["家族・仲間"]},
 {"id": "k5", "no": 6, "date": "2026-11-03", "time": "19:02", "nickname": "見本の日向っ子", "body": "ピンクのユニフォームがスタンドを埋める景色が好き。", "tags": ["スタジアム"]},
 {"id": "k6", "no": 7, "date": "2026-11-04", "time": "20:30", "nickname": "見本のゴール裏一年生", "body": "チャントを覚えて歌えるようになったら、試合がもっと楽しくなりました。まだ全部は覚えてないけど、隣の人が教えてくれます。", "tags": ["応援", "家族・仲間"]},
 {"id": "k7", "no": 8, "date": "2026-11-05", "time": "08:10", "nickname": "", "body": ">>7\nチャントは歌ってるうちに自然に覚えますよ！一緒に歌いましょう。", "tags": ["応援"]},
 {"id": "k8", "no": 9, "date": "2026-11-05", "time": "12:48", "nickname": "見本の都城サポ", "body": "子どもが選手の名前を全部言えるようになりました。家でもずっとチャントを歌っています。", "tags": ["家族・仲間", "選手"]},
 {"id": "k9", "no": 10, "date": "2026-11-06", "time": "23:05", "nickname": "", "body": "終了間際のゴールでスタンドが揺れたあの瞬間、知らない人とハイタッチしてた。", "tags": ["ゴール", "思い出"]},
 {"id": "k10", "no": 11, "date": "2026-11-07", "time": "06:55", "nickname": "見本のチキン南蛮党", "body": ">>2\n帰り道のチキン南蛮派、ここにもいます。", "tags": ["宮崎"]},
 {"id": "k11", "no": 12, "date": "2026-11-08", "time": "18:20", "nickname": "見本のえびの高原", "body": "雨の日の試合でも、カッパを着てみんなで声を出すのが楽しい。濡れても笑って帰れるのがテゲバの試合。", "tags": ["応援", "思い出"]},
 {"id": "k12", "no": 13, "date": "2026-11-08", "time": "21:44", "nickname": "", "body": "テゲバ", "tags": ["クラブ"]},
 {"id": "k13", "no": 14, "date": "2026-11-09", "time": "10:02", "nickname": "見本の延岡のじいちゃん", "body": "孫に連れられて初めて行きました。こんなに近くでサッカーが見られるとは。次は自分から誘います。", "tags": ["家族・仲間", "思い出", "スタジアム"]},
 {"id": "k14", "no": 15, "date": "2026-11-10", "time": "13:37", "nickname": "", "body": ">>14\nすてきなお話！おじいちゃんと孫で観戦、最高ですね。", "tags": ["家族・仲間"]},
 {"id": "k15", "no": 16, "date": "2026-11-10", "time": "15:12", "nickname": "見本の遠征組", "body": "アウェイの帰りの車で、その日のゴールの話を何時間もできる。それが遠征のいちばんの楽しみ。", "tags": ["遠征", "ゴール"]},
 {"id": "k16", "no": 17, "date": "2026-11-11", "time": "09:09", "nickname": "見本の青島の朝", "body": "試合のない日も、街で選手を見かけるとうれしくなる。宮崎の街とクラブが近いのがいい。", "tags": ["宮崎", "選手", "クラブ"]},
 {"id": "k17", "no": 18, "date": "2026-11-12", "time": "20:01", "nickname": "", "body": "スタジアムグルメが毎回楽しみ。", "tags": ["スタジアム", "宮崎"]},
 {"id": "k18", "no": 19, "date": "2026-11-12", "time": "22:58", "nickname": "見本の西都の母", "body": "ハーフタイムに子どもたちが走り回れるのがありがたいです。家族で気楽に行けるクラブでいてほしい。", "tags": ["家族・仲間", "クラブ"]},
 {"id": "k19", "no": 20, "date": "2026-11-13", "time": "11:11", "nickname": "", "body": ">>10\n自分もあの瞬間いました！隣の人と抱き合ってた。", "tags": ["ゴール", "思い出"]},
 {"id": "k20", "no": 21, "date": "2026-11-14", "time": "17:45", "nickname": "見本の日南のサーファー", "body": "海で遊んでからスタジアムへ。宮崎らしい週末の過ごし方です。", "tags": ["宮崎"]},
 {"id": "k21", "no": 22, "date": "2026-11-14", "time": "19:19", "nickname": "見本の大学生サポ", "body": "友だちを誘ったら、次の試合から自分よりハマってた。テゲバには人を引きこむ力がある。", "tags": ["家族・仲間", "応援"]},
 {"id": "k22", "no": 23, "date": "2026-11-15", "time": "07:07", "nickname": "", "body": "選手がスタンドに手を振ってくれるだけで、また来ようと思える。", "tags": ["選手", "スタジアム"]},
 {"id": "k23", "no": 24, "date": "2026-11-15", "time": "21:30", "nickname": "見本のテゲ太郎", "body": ">>23\nほんとそれ。試合後のあいさつまでが楽しみです。", "tags": ["選手"]},
 {"id": "k24", "no": 25, "date": "2026-11-16", "time": "12:00", "nickname": "見本の小林のファーマー", "body": "仕事で毎試合は行けないけど、結果を見るのが毎週の楽しみ。勝った週は仕事もはかどります。", "tags": ["未来"]},
 {"id": "k25", "no": 26, "date": "2026-11-16", "time": "22:22", "nickname": "", "body": "いつか満員のスタジアムで、みんなで勝利を祝いたい。その日まで応援し続けます。", "tags": ["未来", "応援"]},
 {"id": "k26", "no": 27, "date": "2026-11-17", "time": "08:48", "nickname": "見本の門川の釣り人", "body": "ボランティアのみなさんの笑顔に毎回元気をもらっています。クラブを支える人たちも含めてテゲバが好き。", "tags": ["クラブ"]},
 {"id": "k27", "no": 28, "date": "2026-11-17", "time": "20:15", "nickname": "", "body": ">>27\nボランティアさんにも感謝ですね。", "tags": ["クラブ"]},
 {"id": "k28", "no": 29, "date": "2026-11-18", "time": "16:40", "nickname": "見本のはじめて観戦", "body": "友だちに誘われて、はじめて試合を見ました。ルールはよくわからなかったけど、ゴールの瞬間はみんなで立ち上がって、すごく楽しかったです！また行きます。", "tags": ["思い出", "ゴール"]},
 {"id": "k29", "no": 30, "date": "2026-11-18", "time": "18:05", "nickname": "見本の高千穂の峰", "body": ">>26\n満員のスタジアム、見たいですね。まわりの人を一人ずつ誘っていこう。", "tags": ["未来", "家族・仲間"]},
 {"id": "k30", "no": 31, "date": "2026-11-19", "time": "21:21", "nickname": "", "body": "テゲバが勝つと、宮崎がちょっと元気になる気がする。\nそれがいちばん好きなところかも。", "tags": ["宮崎", "クラブ"]},
 {"id": "k31", "no": 32, "date": "2026-11-19", "time": "23:40", "nickname": "見本の串間のいとこ", "body": ">>31\nわかります。月曜の職場がテゲバの話でもちきり。", "tags": ["宮崎"]}
]
