---
import Base from '../layouts/Base.astro';
import SukiForm from '../components/SukiForm.astro';
import { SITE } from '../config/site.js';
import { href, xIntent } from '../lib/util.js';
import { readSuki, nickOf, sukiPost, tagCounts } from '../lib/suki.js';
import { sukiLd } from '../lib/seo.js';
// てげ好き：テゲサポが教えてくれた「テゲバの好きなところ」を、むかしの掲示板のスレッドのように並べる（>>1 はスレ立て）
// レス番号・いいね！（Worker の /api/likes）・言葉でリアルタイムに絞り込み・タグ・並べかえ・表示件数とページ送り
// 1件ずつ X でポスト（先頭50字を引用。画像なし）。届いた声は確認して整えてから src/data/suki.json に載せる（docs/suki.md）
const rows = readSuki();
const tags = tagCounts(rows);
const pageUrl = `${SITE.url}/tegesuki/`;
const likesApi = SITE.spots.api ? new URL('/api/likes', SITE.spots.api).href : '';
const WD = ['日', '月', '火', '水', '木', '金', '土'];
const stamp = (d: string, t = '') => { const [y, m, dd] = d.split('-').map(Number); return `${y}/${String(m).padStart(2, '0')}/${String(dd).padStart(2, '0')}(${WD[new Date(Date.UTC(y, m - 1, dd)).getUTCDay()]})${t ? ' ' + t : ''}`; };
const first = rows[0]?.date || new Date().toISOString().slice(0, 10);
const summary = rows.length ? `${rows.length}件の声${tags.length ? `（${tags.slice(0, 4).map(t => `${t.tag} ${t.n}件`).join('・')}）` : ''}` : '';
---
<Base current="tegesuki" ld={[sukiLd(rows, pageUrl)]} title="てげ好き テゲバの好きなところを語るスレ"
  description={`テゲバジャーロ宮崎の好きなところを、テゲサポのみんなで語るスレ「てげ好き」。${summary ? `${summary}。` : ''}選手・応援・スタジアム・宮崎のことまで、テゲバへの声を集めています（非公式サポーターサイト）。`}>
  <section class="card bbs" data-likes-api={likesApi}>
    <h2 class="bbs-title">【テゲバジャーロ宮崎】てげ好き テゲバの好きなところを語るスレ</h2>
    <!-- 書き込み欄はスレの下（読んでから書きたくなるように）。上には、そこへ移るボタンを置く -->
    <div class="bbs-sub"><p><b data-suki-n>{rows.length + 1}</b> レス</p><a class="ask-btn ask-site" href="#write">声を書き込む</a></div>

    {rows.length > 0 && (
      <div class="bbs-tools">
        {tags.length > 0 && (
          <div class="seg suki-tags" role="group" aria-label="タグでしぼる">
            <button type="button" data-tag="" aria-pressed="true">すべて</button>
            {tags.map(t => <button type="button" data-tag={t.tag} aria-pressed="false" title={t.desc}>{t.tag}<span class="n">{t.n}</span></button>)}
          </div>
        )}
        <div class="suki-ctl">
          <label class="suki-q"><span class="visually-hidden">言葉でさがす</span><input type="search" id="sukiQ" placeholder="言葉でさがす（例：ゴール裏）" autocomplete="off" enterkeyhint="search" /></label>
          <label class="suki-sort"><span class="visually-hidden">並べかえ</span>
            <select id="sukiSort">
              <option value="old">古い順</option>
              <option value="new">新しい順</option>
              <option value="like">いいね！が多い順</option>
              <option value="long">長い順</option>
            </select>
          </label>
          <label class="suki-sort suki-per"><span class="visually-hidden">表示件数</span>
            <select id="sukiPer">
              <option value="20">20件ずつ</option>
              <option value="50">50件ずつ</option>
              <option value="100">100件ずつ</option>
            </select>
          </label>
        </div>
        <p class="suki-none" id="sukiNone" hidden>当てはまるレスはありません。</p>
      </div>
    )}

    <ol class="bbs-list" id="sukiList">
      <li class="res res-1" id="r1" data-no="1" data-pin>
        <p class="res-h"><span class="res-no">1</span>：<span class="res-nm">テゲスタ！</span><span class="res-mark">★</span>：<span class="res-at">{stamp(first)}</span></p>
        <div class="res-body">テゲバの好きなところを、みんなで語ろう。
選手のこと、ゴール裏の熱さ、スタジアムの空気、宮崎のこと、忘れられない試合。ひとことでもOK。
いいなと思ったレスには「いいね！」を。
届いた声は確認してから載せます。載った声は、テゲサポの記録としてずっと残ります。</div>
      </li>
      {rows.map(r => (
        <li class="res" id={`r${r.no}`} data-no={r.no} data-date={`${r.date} ${r.time}`} data-len={[...r.body].length} data-tags={r.tags.join('|')}>
          <p class="res-h"><span class="res-no">{r.no}</span>：<span class="res-nm">{nickOf(r)}</span>：<span class="res-at">{stamp(r.date, r.time)}</span></p>
          <div class="res-body">{r.body}</div>
          <div class="res-act">
            {likesApi && <button type="button" class="res-like" data-like={`r${r.no}`} aria-pressed="false"><span class="lb">いいね！</span><span class="n" data-n></span></button>}
            <a class="res-x" href={xIntent(sukiPost(r), `${pageUrl}#r${r.no}`, '')} target="_blank" rel="noopener noreferrer">X でポスト</a>
            {r.tags.length > 0 && <span class="res-tags">{r.tags.map(t => <button type="button" data-tagpick={t}>#{t}</button>)}</span>}
          </div>
        </li>
      ))}
    </ol>
    <nav class="bbs-pager" id="sukiPager" aria-label="ページ" hidden>
      <p class="bbs-range" id="sukiRange" aria-live="polite"></p>
      <div class="bbs-pages">
        <button type="button" data-page="prev">前へ</button>
        <span class="bbs-nums" id="sukiNums"></span>
        <button type="button" data-page="next">次へ</button>
      </div>
    </nav>
    {rows.length === 0 && <p class="bbs-empty">まだレスはありません。いちばん乗りで、テゲバの好きなところを書き込んでください！</p>}
  </section>
  <!-- 一覧の先頭（さがす・並べかえ）へ戻る。一覧を下まで読み進めたときだけ、画面の右下に出る -->
  <button type="button" class="to-top" id="sukiTop" hidden>一覧の先頭へ</button>

  <section class="card bbs-write" id="write">
    <h2 class="bbs-write-h">書き込む</h2>
    <SukiForm id="sukiWrite" />
  </section>
  <p class="note suki-note">届いた声は、テゲスタ！で確認してから載せています。読みやすいように、一部の表現を整えていることがあります。ここに並ぶ声は、テゲバを応援してきたテゲサポの記録として、ずっと大切に残していきます。</p>
</Base>

<script>
  import { toHiragana } from '../lib/namesearch.js';
  const list = document.getElementById('sukiList') as HTMLOListElement;
  const all = [...list.querySelectorAll<HTMLLIElement>('li.res')];
  const items = all.filter(li => !li.hasAttribute('data-pin'));
  const byNo = new Map(all.map(li => [li.dataset.no!, li]));

  // ---- レスの #タグ：そのタグでしぼりこむ ----
  list.addEventListener('click', e => {
    const t = e.target as HTMLElement;
    const tp = t.closest<HTMLButtonElement>('[data-tagpick]');
    if (tp) { pickTag(tp.dataset.tagpick!); document.querySelector('.bbs')?.scrollIntoView({ block: 'start' }); }
  });

  // ---- いいね！：数は Worker から。押したかどうかはこの端末に覚えておく ----
  const api = (document.querySelector('.bbs') as HTMLElement).dataset.likesApi;
  const likes = new Map<string, number>();
  const mine = (() => { try { return new Set<string>(JSON.parse(localStorage.getItem('tg:likes') || '[]')); } catch { return new Set<string>(); } })();
  const save = () => { try { localStorage.setItem('tg:likes', JSON.stringify([...mine])); } catch { /* 覚えられなくても続ける */ } };
  const paint = () => list.querySelectorAll<HTMLButtonElement>('[data-like]').forEach(b => {
    const id = b.dataset.like!, n = likes.get(id) || 0;
    b.setAttribute('aria-pressed', String(mine.has(id)));
    b.querySelector('[data-n]')!.textContent = n ? String(n) : '';
  });
  paint();
  if (api && items.length) {
    fetch(api, { cache: 'no-store' }).then(r => r.ok ? r.json() : null).then(d => { if (d?.counts) { for (const [k, v] of Object.entries(d.counts)) likes.set(k, Number(v)); paint(); if (sort?.value === 'like') order(); } }).catch(() => {});
    list.addEventListener('click', async e => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-like]');
      if (!b) return;
      const id = b.dataset.like!, on = !mine.has(id);
      if (on) mine.add(id); else mine.delete(id);
      likes.set(id, Math.max(0, (likes.get(id) || 0) + (on ? 1 : -1))); save(); paint();
      b.classList.remove('pop'); void b.offsetWidth; if (on) b.classList.add('pop');
      try {
        const r = await fetch(api, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, on }) });
        const d = await r.json().catch(() => null);
        if (d && typeof d.n === 'number') { likes.set(id, d.n); paint(); }
      } catch { /* 数は次に開いたときにそろう */ }
    });
  }

  // ---- 言葉でさがす・タグ・並べかえ ----
  const q = document.getElementById('sukiQ') as HTMLInputElement | null;
  const sort = document.getElementById('sukiSort') as HTMLSelectElement | null;
  const none = document.getElementById('sukiNone');
  const count = document.querySelector('[data-suki-n]')!;
  const tagBtns = [...document.querySelectorAll<HTMLButtonElement>('.suki-tags [data-tag]')];
  const norm = (s: string) => toHiragana(s).toLowerCase().replace(/\s+/g, '');
  const text = new Map(items.map(li => [li, norm(li.querySelector('.res-h')!.textContent! + li.querySelector('.res-body')!.textContent! + (li.dataset.tags || ''))]));
  const per = document.getElementById('sukiPer') as HTMLSelectElement | null;
  const pager = document.getElementById('sukiPager')!;
  const range = document.getElementById('sukiRange')!;
  const nums = document.getElementById('sukiNums')!;
  const pin = byNo.get('1')!;
  let tag = '', page = 0, matched: HTMLLIElement[] = [];
  try { const v = localStorage.getItem('tg:sukiPer'); if (per && v && [...per.options].some(o => o.value === v)) per.value = v; } catch { /* 覚えていなくてもよい */ }
  const size = () => Number(per?.value) || 20;
  const pages = () => Math.max(1, Math.ceil(matched.length / size()));

  // 並べかえ → しぼりこみ → ページで切り出す、の順に毎回作り直す
  const by: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    old: (a, b) => Number(a.dataset.no) - Number(b.dataset.no),
    new: (a, b) => Number(b.dataset.no) - Number(a.dataset.no),
    like: (a, b) => (likes.get(`r${b.dataset.no}`) || 0) - (likes.get(`r${a.dataset.no}`) || 0) || Number(a.dataset.no) - Number(b.dataset.no),
    long: (a, b) => Number(b.dataset.len) - Number(a.dataset.len),
  };
  const terms = () => (q?.value || '').split(/[\s　]+/).map(norm).filter(Boolean);
  const filtering = () => !!(tag || terms().length);
  function compute() {
    const ts = terms();
    const sorted = [...items].sort(by[sort?.value || 'old'] || by.old);
    matched = sorted.filter(li => (!tag || (li.dataset.tags || '').split('|').includes(tag)) && ts.every(t => text.get(li)!.includes(t)));
    list.append(pin, ...sorted);
  }
  // 検索した言葉に色を付ける（CSS Custom Highlight API。ページの文字には手を加えないので、リンクや折り返しに影響しない。
  // 使えないブラウザでは色が付かないだけ）。ひらがな・カタカナ・全角半角のちがいは、絞り込みと同じく無視して探す
  const canMark = typeof CSS !== 'undefined' && 'highlights' in CSS;
  function mark(shown: Iterable<HTMLLIElement>) {
    if (!canMark) return;
    const ts = terms(), ranges: Range[] = [];
    if (ts.length) for (const li of shown) for (const el of li.querySelectorAll('.res-nm, .res-body')) {
      // 文字ごとに「探す用の文字」と「元の場所」を対応させる（文が細かい span に分かれていても、つなげて探す）
      let flat = '';
      const at: [Text, number, number][] = [];
      const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      for (let n = walk.nextNode() as Text | null; n; n = walk.nextNode() as Text | null) {
        let i = 0;
        for (const ch of n.data) {
          const c = norm(ch);
          for (const x of c) { flat += x; at.push([n, i, ch.length]); }
          i += ch.length;
        }
      }
      for (const t of ts) {
        for (let k = flat.indexOf(t); k >= 0; k = flat.indexOf(t, k + t.length)) {
          const [sn, so] = at[k], [en, eo, el2] = at[k + t.length - 1];
          const r = document.createRange();
          r.setStart(sn, so); r.setEnd(en, eo + el2);
          ranges.push(r);
        }
      }
    }
    // @ts-ignore Highlight は新しめの API
    CSS.highlights.set('suki-q', new Highlight(...ranges));
  }

  function render() {
    page = Math.min(Math.max(0, page), pages() - 1);
    const from = page * size(), show = new Set(matched.slice(from, from + size()));
    for (const li of items) li.hidden = !show.has(li);
    mark(show);
    // >>1（スレのはじめ）は、しぼりこみなしの1ページ目だけ
    pin.hidden = filtering() || page > 0;
    const f = filtering();
    count.textContent = String(f ? matched.length : matched.length + 1);
    if (none) none.hidden = matched.length > 0 || !f;
    const many = matched.length > size();
    pager.hidden = !many;
    if (many) {
      range.textContent = `${from + 1}〜${Math.min(from + size(), matched.length)}件目（${matched.length}件中）`;
      const n = pages(), want = new Set([0, n - 1, page - 1, page, page + 1].filter(i => i >= 0 && i < n));
      const out: (HTMLElement | Text)[] = [];
      let last = -1;
      for (const i of [...want].sort((a, b) => a - b)) {
        if (i - last > 1) out.push(document.createTextNode('…'));
        const b = document.createElement('button');
        b.type = 'button'; b.dataset.page = String(i); b.textContent = String(i + 1);
        if (i === page) b.setAttribute('aria-current', 'page');
        out.push(b); last = i;
      }
      nums.replaceChildren(...out);
      pager.querySelector<HTMLButtonElement>('[data-page="prev"]')!.disabled = page === 0;
      pager.querySelector<HTMLButtonElement>('[data-page="next"]')!.disabled = page >= n - 1;
    }
  }
  const apply = () => { page = 0; compute(); render(); };
  function order() { compute(); render(); }
  function pickTag(t: string) {
    tag = t;
    for (const b of tagBtns) b.setAttribute('aria-pressed', String((b.dataset.tag || '') === t));
    apply();
  }
  // レス番号のレスを見えるようにする（しぼりこみで外れていたら解除して、そのレスのあるページへ）
  function reveal(no: string) {
    const li = byNo.get(no);
    if (!li || li === pin) { if (filtering() || page > 0) { if (q) q.value = ''; pickTag(''); } return; }
    if (!matched.includes(li)) { if (q) q.value = ''; tag = ''; for (const b of tagBtns) b.setAttribute('aria-pressed', String(!b.dataset.tag)); compute(); }
    page = Math.floor(matched.indexOf(li) / size());
    render();
    all.forEach(x => x.classList.toggle('hit', x === li));
  }
  q?.addEventListener('input', apply);
  sort?.addEventListener('change', apply);
  per?.addEventListener('change', () => { try { localStorage.setItem('tg:sukiPer', per.value); } catch { /* 覚えなくてもよい */ } apply(); });
  for (const b of tagBtns) b.addEventListener('click', () => pickTag(b.dataset.tag || ''));
  pager.addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-page]');
    if (!b || b.disabled) return;
    const v = b.dataset.page!;
    page = v === 'prev' ? page - 1 : v === 'next' ? page + 1 : Number(v);
    render();
    (q?.closest('.bbs-tools') || list).scrollIntoView({ block: 'start' });
  });
  order();

  // ---- 一覧の先頭へ：さがす欄が画面の上に消えていて、まだ一覧の中を読んでいるときだけ出す ----
  const toTop = document.getElementById('sukiTop')!;
  const tools = document.querySelector<HTMLElement>('.bbs-tools') || list;
  let rqTop = 0;
  const updTop = () => {
    rqTop = 0;
    const listBottom = list.getBoundingClientRect().bottom;
    toTop.hidden = !(tools.getBoundingClientRect().bottom < -innerHeight * 0.5 && listBottom > innerHeight * 0.4);
  };
  addEventListener('scroll', () => { if (!rqTop) rqTop = requestAnimationFrame(updTop); }, { passive: true });
  toTop.addEventListener('click', () => { tools.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); });
  updTop();

  // #r12 で来たら、そのレスのあるページを開いて目立たせる
  const go = () => { const h = location.hash.match(/^#r(\d+)$/); if (h) { reveal(h[1]); byNo.get(h[1])?.scrollIntoView({ block: 'start' }); } };
  go();
  addEventListener('hashchange', go);
</script>
