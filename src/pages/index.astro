---
import Base from '../layouts/Base.astro';
import ShareCard from '../components/ShareCard.astro';
import { getData, getShareables, readCsv } from '../lib/data.js';
import { nextMatch } from '../lib/nextmatch.js';
import PostBox from '../components/PostBox.astro';
import { icon, xIntent, X_MARK } from '../lib/util.js';
import { formSummary, RES_WORD } from '../lib/form.js';
import { SITE } from '../config/site.js';
const fs = formSummary(getData().matches);
const items = getShareables().filter(s => s.kind === 't');
// 次の試合：ビルドした時点の表示を入れておき、ブラウザで今日の日時（日本時間）に合わせて書き換える（site.js）
const fixtures = readCsv('fixtures');
const lite = getData().matches.map(m => ({ round: m.round, opponent: m.opponent, gf: m.gf, ga: m.ga, result: m.result }));
const nx = nextMatch(fixtures, lite);
const nxPost = nx ? xIntent(`${nx.post}\n${SITE.hashtags}`, `${SITE.url}/`, '') : '';
---
<Base current="topics">
  {nx && (
    <section class="card nextcard reveal" id="next" data-mode={nx.mode}>
      <script type="application/json" id="next-data" is:inline set:html={JSON.stringify({ fixtures, matches: lite }).replace(/</g, '\\u003c')}></script>
      <div class="label"><Fragment set:html={icon('calendar')} />次の試合<span class="nx-tag" data-nx="tag">{nx.tag}</span></div>
      <div class="nx-big" data-nx="big">{nx.big}</div>
      <div class="nx-info">
        <div class="nx-vs" data-nx="vs">vs {nx.vs.replace(/戦$/, '')}</div>
        <div class="nx-when" data-nx="when">{nx.when}</div>
        <div class="nx-where"><span class={`nx-ha ${nx.fx.ha === 'H' ? 'h' : 'a'}`} data-nx="ha">{nx.fx.ha === 'H' ? 'ホーム' : 'アウェイ'}</span><span data-nx="venue">{nx.fx.venue}</span></div>
      </div>
      <p class="nx-sub" data-nx="sub" hidden={!nx.sub}>{nx.sub}</p>
      <p class="cheer nx-hook" data-nx="hook">{nx.hook}</p>
      <div class="post">
        <a class="postbtn" data-nx="post" href={nxPost} target="_blank" rel="noopener noreferrer">
          <Fragment set:html={X_MARK} /><span><b class="nw">「次の試合」</b><span class="nw">をXでポスト</span></span>
        </a>
      </div>
    </section>
  )}
  <section class="card formcard reveal" id="form">
    <div class="label"><Fragment set:html={icon('chartup')} />直近5試合</div>
    <div class="ftitle">{fs.show}</div>
    {fs.badges.length > 0 && <div class="fbadges">{fs.badges.map(b => <span class="fbadge"><Fragment set:html={icon('flame')} />{b}</span>)}</div>}
    <div class="sub">{fs.sub}</div>
    <div class="form">
      {fs.last.map((m, i) => (
        <div class={m.result === '勝' ? 'w' : m.result === '負' ? 'l' : 'd'}>
          {i === fs.last.length - 1 && <span class="newtag">最新</span>}
          <span class="res">{RES_WORD[m.result] || m.result}</span>
          <span class="sc">{m.gf}-{m.ga}</span>
          <span class="op">vs {m.opponent}</span>
          <span class="rd">第{m.round}節</span>
          <span class="rd">{m.ha === 'H' ? 'ホーム' : 'アウェイ'}</span>
        </div>
      ))}
    </div>
    <p class="cheer">{fs.cheer}</p>
    <PostBox what="直近5試合" text={fs.text} url={`${SITE.url}/`} />
  </section>
  <p class="page-lead">カードを押すと、ポスト用の画像つきページが開きます。</p>
  <section class="bday" data-bday hidden></section>
  <div class="grid">
    {items.map(item => <ShareCard item={item} />)}
  </div>
</Base>
