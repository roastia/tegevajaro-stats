---
import BdaySoon from '../components/BdaySoon.astro';
import Base from '../layouts/Base.astro';
import { clubUrl } from '../config/clubs.js';
import ShareCard from '../components/ShareCard.astro';
import { getData, getShareables } from '../lib/data.js';
import { milestonePost } from '../lib/milestones.js';
import PostBox from '../components/PostBox.astro';
import Acc from '../components/Acc.astro';
import { icon, xLength, flatPost } from '../lib/util.js';
import { formSummary, RES_WORD } from '../lib/form.js';
import { SITE } from '../config/site.js';
import { readCsv } from '../lib/data.js';
import { faqItems, faqLd } from '../lib/seo.js';
const fs = formSummary(getData().matches);
// 首位浮上はランキングのページの先頭に出す
const items = getShareables().filter(s => s.kind === 't' && s.id !== 'climb');
// 記録まであと少し：ポスト文は X に収まるだけ載せる
const ms = getData().milestones;
const msUrl = `${SITE.url}/`;
const msText = milestonePost(ms, t => xLength(flatPost(`${t}\n${SITE.hashtags}`, SITE.roundLabel), msUrl) <= 280) + `\n${SITE.hashtags}`;
const msNear = ms.near.slice(0, 6);
// よくある質問：今の順位・得点王・次の試合など、サイトの数字から作る（検索や AI の要約で、いつ時点の答えかが伝わるように）
const faq = faqItems(getData(), readCsv('fixtures'));
---
<Base current="topics" ld={[faqLd(faq)]}>
  <section class="card formcard reveal" id="form">
    <div class="label"><Fragment set:html={icon('chartup')} />直近5試合</div>
    <div class="ftitle">{fs.show}</div>
    {fs.badges.length > 0 && <div class="fbadges">{fs.badges.map(b => <span class="fbadge"><Fragment set:html={icon('flame')} />{b}</span>)}</div>}
    <div class="sub">{fs.sub}</div>
    <div class="form">
      {fs.last.map((m, i) => (
        <div class={m.result === '勝' ? 'w' : m.result === '負' ? 'l' : 'd'}>
          {i === fs.last.length - 1 && <span class="newtag">最新</span>}
          <span class="res">{RES_WORD[m.result] || m.result}</span>
          <span class="sc">{m.gf}-{m.ga}</span>
          <span class="op">vs {clubUrl(m.opponent) ? <a class="club-link" href={clubUrl(m.opponent)} target="_blank" rel="noopener noreferrer">{m.opponent}</a> : m.opponent}</span>
          <span class="rd">第{m.round}節</span>
          <span class="rd">{m.ha === 'H' ? 'ホーム' : 'アウェイ'}</span>
        </div>
      ))}
    </div>
    <p class="cheer">{fs.cheer}</p>
    <PostBox what="直近5試合" text={fs.text} url={`${SITE.url}/`} />
  </section>
  <BdaySoon />
  <Acc id="topics" title="今季の話題" icon="sparkle" count={items.length}>
    <div class="grid">
      {items.map(item => <ShareCard item={item} />)}
    </div>
  </Acc>
  {(ms.near.length > 0 || ms.done.length > 0) && (
    <Acc id="milestones" title="記録まであと少し" icon="flag" count={ms.done.length + msNear.length}>
    <section class="card mscard reveal">
            {ms.done.length > 0 && (
        <div class="ms-block">
          <h2 class="ms-h done"><Fragment set:html={icon('party')} />第{ms.round}節で達成！</h2>
          <ul class="ms-list">
            {ms.done.map(x => <li class="done"><Fragment set:html={icon(x.icon)} /><span><b class="who">{x.who}</b><span class="tx">{x.text}</span></span></li>)}
          </ul>
        </div>
      )}
      {msNear.length > 0 && (
        <div class="ms-block">
          <h2 class="ms-h"><Fragment set:html={icon('target')} />次の試合で記録がかかる</h2>
          <ul class="ms-list">
            {msNear.map(x => <li><Fragment set:html={icon(x.icon)} /><span><b class="who">{x.who}</b><span class="tx">{x.text}</span></span></li>)}
          </ul>
        </div>
      )}
      <PostBox what="記録まであと少し" text={msText} url={msUrl} />
    </section>
    </Acc>
  )}
  <Acc id="faq" title="よくある質問" icon="magnifier" open={false}>
    <section class="card faq">
      {faq.map(x => (
        <details class="faq-q">
          <summary>{x.q}</summary>
          <p>{x.a}</p>
        </details>
      ))}
    </section>
  </Acc>
</Base>
