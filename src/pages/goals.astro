---
import { SITE } from '../config/site.js';
import Base from '../layouts/Base.astro';
import Acc from '../components/Acc.astro';
import { getData, readCsv } from '../lib/data.js';
import { buildLineups } from '../lib/lineups.js';
import { icon, safeUrl, href } from '../lib/util.js';
// ハイライト：試合ごとに「ハイライト動画・その試合のゴール・スタメン」をまとめる
const d = getData();
const L = buildLineups({ lineups: readCsv('lineups'), matches: readCsv('matches'), players: readCsv('players') });
const xiOf = new Map(L.games.map(g => [String(g.round), g]));
const counts = {};
d.goals.forEach(g => { counts[g.scorer] = (counts[g.scorer] || 0) + 1; });
const scorers = Object.entries(counts).sort((a, b) => b[1] - a[1]);
const matches = [...d.matches].sort((a, b) => Number(b.round) - Number(a.round));
// 大項目（アコーディオン）：月ごと。いちばん新しい月だけ開いておく
const months = [...new Set(matches.map(m => m.date.slice(0, 7)))].map(k => [k, matches.filter(m => m.date.slice(0, 7) === k)]);
const ha = m => (m.ha === 'H' ? 'ホーム' : 'アウェイ');
const md = s => { const [, m, dd] = s.split('-').map(Number); return `${m}/${dd}`; };
const resCls = { 勝: 'win', 分: 'draw', 負: 'lose' };
const resWord = { 勝: '勝ち', 分: '引き分け', 負: '負け' };
---
<Base current="goals" title="試合ハイライト・スタメン" description={`テゲバジャーロ宮崎の今季の試合ハイライト動画・ゴールした選手・スタメンとフォーメーションを試合ごとにまとめました（非公式）。${SITE.roundLabel}時点。`}>
  <section class="hl-controls" aria-label="絞り込み">
    <div class="controls">
      <div class="seg" id="resSeg" role="group" aria-label="結果">
        {['', '勝', '分', '負'].map((r, i) => <button type="button" data-res={r} aria-pressed={i === 0 ? 'true' : 'false'}>{r || 'すべて'}</button>)}
      </div>
      <select id="scorerSel" aria-label="ゴールを決めた選手">
        <option value="">全員のゴール（{d.goals.length}）</option>
        {scorers.map(([n, c]) => <option value={n}>{n}（{c}ゴール）</option>)}
      </select>
      <select id="mOrder" aria-label="並び順"><option value="desc">新しい順</option><option value="asc">古い順</option></select>
    </div>
  </section>
  <div class="hl-months" id="matchList">
    {months.map(([mk, list], gi) => (
    <Acc id={`m-${mk}`} title={`${Number(mk.slice(5))}月の試合`} icon="calendar" count={`${list.length}試合`} open={gi === 0}>
    <ul class="grid hl-games" data-month={mk}>
    {list.map(m => { const gs = d.goals.filter(g => String(g.round) === String(m.round)).sort((a, b) => Number(a.minute) - Number(b.minute)); const v = safeUrl(m.video_url), p = safeUrl(m.match_url); const g = xiOf.get(String(m.round)); return (
      <li class="card hl-game" data-res={m.result} data-round={m.round} data-scorers={[...new Set(gs.map(x => x.scorer))].join('|')}>
        <div class="lu-head">
          <span class="lu-rd">第{m.round}節</span>
          <span class="lu-vs">{md(m.date)} {m.opponent}<small>（{ha(m)}）</small></span>
          <span class={`lu-res ${resCls[m.result] || ''}`}>{m.gf}-{m.ga} {resWord[m.result] || ''}</span>
        </div>
        <div class="hl-acts">
          {v && <a class="hl-play" href={v} target="_blank" rel="noopener noreferrer"><Fragment set:html={icon('play')} />ハイライトを見る</a>}
          {p && <a class="hl-official" href={p} target="_blank" rel="noopener noreferrer">公式試合ページ</a>}
        </div>
        {gs.length
          ? <ul class="glist">{gs.map(x => <li data-scorer={x.scorer}><Fragment set:html={icon('ball')} /><span class="gt">{x.time}</span><b>{x.scorer}</b></li>)}</ul>
          : <p class="glist none">宮崎の得点なし</p>}
        {g && (
          <details class="hl-xi">
            <summary>スタメン＆フォーメーション<span class="xi-form">{g.formation}</span></summary>
            <div class="pitch" role="img" aria-label={`${g.formation}：${g.lines.flat().map(x => `${x.role} ${x.name}`).join('、')}`}>
              <span class="pa" aria-hidden="true"></span><span class="ga" aria-hidden="true"></span><span class="parc" aria-hidden="true"></span>
              <span class="lu-form">{g.formation}</span>
              {g.lines.map(line => (
                <div class={`pl-row n${line.length}`}>
                  {line.map(x => (
                    <div class="pl" data-name={x.name}>
                      {x.no ? <img class="jersey pl-j" src={href(`chars/numbers-s/${x.no}.png`)} alt={`背番号${x.no}`} width="128" height="128" loading="lazy" /> : <span class="pl-j" />}
                      <span class="pl-n">{x.short}</span>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </details>
        )}
      </li>); })}
    </ul>
    </Acc>))}
  </div>
  <p class="hl-empty" id="hlEmpty" hidden>該当する試合はありません</p>

</Base>
<style>
  .two { grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
</style>
<script>
  // 結果・ゴールを決めた選手・並び順で絞り込む。選手を選ぶと、その選手のゴールとスタメン図の位置に印をつける
  const $ = (id: string) => document.getElementById(id)!;
  const ml = [...$('matchList').querySelectorAll<HTMLElement>('li.hl-game')];
  const groups = [...$('matchList').querySelectorAll<HTMLDetailsElement>('details.acc')];
  let res = '';
  const draw = () => {
    const who = ($('scorerSel') as HTMLSelectElement).value;
    const desc = ($('mOrder') as HTMLSelectElement).value === 'desc';
    const n = (e: HTMLElement) => Number(e.dataset.round);
    let shown = 0;
    [...ml].sort((a, b) => (desc ? -1 : 1) * (n(a) - n(b))).forEach((e, i) => {
      e.style.order = String(i);
      e.hidden = (!!res && e.dataset.res !== res) || (!!who && !(e.dataset.scorers || '').split('|').includes(who));
      if (!e.hidden) shown++;
      e.querySelectorAll<HTMLElement>('.glist li').forEach(g => { g.classList.toggle('me', !!who && g.dataset.scorer === who); g.classList.toggle('dim', !!who && g.dataset.scorer !== who); });
      e.querySelectorAll<HTMLElement>('.pl').forEach(g => g.classList.toggle('me', !!who && g.dataset.name === who));
    });
    $('hlEmpty').hidden = shown > 0;
    // 月のまとまり：並び順に合わせて並べ、絞り込みで0試合になった月は隠す。絞り込んだときは該当のある月を開く
    groups.forEach((g, i) => {
      g.style.order = String(desc ? i : groups.length - i);
      const n = g.querySelectorAll('li.hl-game:not([hidden])').length;
      g.hidden = n === 0;
      const c = g.querySelector('.acc-n'); if (c) c.textContent = `${n}試合`;
      if ((res || who) && n > 0) g.open = true;
    });
  };
  ['scorerSel', 'mOrder'].forEach(id => $(id).addEventListener('change', draw));
  $('resSeg').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    res = b.dataset.res || '';
    $('resSeg').querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    draw();
  });
</script>
