---
import { SITE } from '../config/site.js';
import Base from '../layouts/Base.astro';
import RankCard from '../components/RankCard.astro';
import ClimbBoard from '../components/ClimbBoard.astro';
import Acc from '../components/Acc.astro';
import { getData, getShareables } from '../lib/data.js';
const d = getData();
// ランキングの先頭：テゲスタ！ランキングの首位浮上（前の節から1位が入れかわったとき）
const climb = getShareables().find(s => s.kind === 't' && s.id === 'climb');
const share = new Map(getShareables().filter(s => s.kind === 'r').map(s => [s.id, s]));
// 大項目（アコーディオン）：ランキングの種類ごと
const CAT_ICON = { goal: 'ball', time: 'stopwatch', team: 'flag', play: 'network', trivia: 'star' };
const cats = [['goal', 'ゴール'], ['time', '出場'], ['team', '貢献'], ['play', 'プレー'], ['trivia', 'トリビア']]
  .filter(([c]) => c && d.rankings.some(r => r.meta.cat === c && r.rows.length));
---
<Base current="ranking" title="選手ランキング" description={`テゲバジャーロ宮崎の選手ランキング。得点・アシスト・出場時間・決勝ゴールなど、今季の記録から独自に集計したランキングを、選手の称号つきで（非公式）。${SITE.roundLabel}時点。`}>
  {climb && d.climbs?.length > 0 && <ClimbBoard climbs={d.climbs} prevRound={d.prevRound} round={SITE.roundLabel} share={climb} />}
  {d.prevRound > 0 && <p class="page-lead mv-lead"><span class="mv up" aria-hidden="true">↑2</span><span class="mv down" aria-hidden="true">↓1</span><span class="mv new" aria-hidden="true">NEW</span>は第{d.prevRound}節からの順位の動き（NEW は第{d.prevRound}節でランク外）</p>}
  <div id="recGrid">
    {cats.map(([c, l], i) => { const list = d.rankings.filter(r => r.rows.length && r.meta.cat === c); return (
      <Acc id={c} title={l} icon={CAT_ICON[c]} count={list.length}>
        <div class="grid">
          {list.map(({ meta, rows }) => <RankCard meta={meta} rows={rows} share={share.get(meta.id)} />)}
        </div>
      </Acc>); })}
  </div>
</Base>
<script>
  // 行をタップすると内訳（「ピッチにいる間 得点18・失点13」など）を開く
  const toggleRow = (li: HTMLElement) => {
    const det = li.querySelector<HTMLElement>('.det'); if (!det) return;
    det.hidden = !det.hidden; li.setAttribute('aria-expanded', String(!det.hidden));
  };
  document.getElementById('recGrid')?.addEventListener('click', e => {
    if ((e.target as HTMLElement).closest('a')) return;
    const li = (e.target as HTMLElement).closest<HTMLElement>('li.has-det'); if (li) toggleRow(li);
  });
  document.getElementById('recGrid')?.addEventListener('keydown', e => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('li.has-det');
    if (li && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); toggleRow(li); }
  });
</script>
