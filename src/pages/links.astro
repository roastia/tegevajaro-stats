---
import Base from '../layouts/Base.astro';
import Acc from '../components/Acc.astro';
import { readCsv } from '../lib/data.js';
import { siteUrl, href } from '../lib/util.js';
import { SITE } from '../config/site.js';
import { linksLd } from '../lib/seo.js';
// リンク集：src/data/links.csv。テゲバを応援・発信している人たちのチャンネルを中心に（公式は公式サイト1つだけ）
const GROUPS = [
  ['official', '公式', 'link'],
  ['program', '番組', 'play'],
  ['group', '団体', 'flag'],
  ['youtube', 'YouTube', 'play'],
  ['read', '読みもの', 'gift'],
];
const rows = readCsv('links').map(r => ({ ...r, url: siteUrl(r.url), host: (() => { try { return new URL(r.url).host.replace(/^www\./, ''); } catch { return ''; } })() })).filter(r => r.name && r.url);
// 情報提供の受付：おすすめスポットと同じ Worker（/api/links）・同じ Turnstile
const linksApi = SITE.spots.api ? new URL('/api/links', SITE.spots.api).href : '';
const ready = !!(linksApi && SITE.spots.turnstileSiteKey);
const fans = rows.filter(r => r.group === 'group' || r.group === 'youtube').length;
---
<Base current="links" ld={[linksLd(rows)]} title="リンク集" description="テゲバジャーロ宮崎を応援・発信している団体やYouTubeチャンネル、応援番組のリンク集（非公式）。">
  <section class="card links-hero">
    <h2 class="links-h">テゲバを応援する人たち</h2>
    <p class="page-lead">テゲバジャーロ宮崎を応援し、発信している人たちのリンク集です。ゴール裏で声を出す人、遠征を記録する人、試合を語り合う人。テゲバを応援している人は、こんなにいます。気になるチャンネルをのぞいて、いっしょに盛り上がりましょう！</p>
    <p class="links-count">団体・チャンネル <b>{fans}</b></p>
    <div class="miya-acts"><a class="btn-sub" href="#post">テゲバの情報を教える</a></div>
  </section>
  {GROUPS.map(([id, label, ic]) => {
    const list = rows.filter(r => r.group === id);
    return list.length > 0 && (
      <Acc id={`links-${id}`} title={label} icon={ic} count={list.length > 1 ? list.length : ''}>
        <section class="link-body">
          <ul class="link-list">
            {list.map(r => (
              <li>
                <a class="link-item" href={r.url} target="_blank" rel="noopener noreferrer">
                  <span class="link-name">{r.name}</span><span class="link-host">{r.host}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </Acc>
    );
  })}
  <Acc id="post" title="テゲバの情報を教えて！" icon="sparkle">
  <section class="card spot-form-card">
    <p class="spot-ask">テゲバの情報を発信しているチャンネルやホームページを知っていたら、教えてください。YouTube・ブログ・note・ポッドキャストなど、何でも大歓迎です。自分のチャンネルの紹介もうれしいです！</p>
    <details class="spot-privacy spot-rules">
      <summary>投稿のルール</summary>
      <ul>
        <li>送ってもらった URL は、すぐにはページに載りません。確認してから、このページに載せます。</li>
        <li>載せるかどうか・載せる文面は、こちらで判断します（個人の情報がわかるもの、宣伝、悪口などは載せません）。</li>
        <li>同じ回線（Wi-Fi など）からの送信は1日10件まで、同じ URL は1回だけ受け付けます。</li>
        <li>載せた内容を消してほしいときは、<a href={href('removal/')}>こちら</a>からご連絡ください。</li>
      </ul>
    </details>
    {ready ? (
      <form class="spot-form" id="linkForm" novalidate data-api={linksApi} data-sitekey={SITE.spots.turnstileSiteKey}>
        <label>URL<span class="req">必須</span><input name="url" type="url" required maxlength="300" autocomplete="off" autocapitalize="off" spellcheck="false" inputmode="url" placeholder="https://" /></label>
        <div class="hp" aria-hidden="true"><label>ウェブサイト<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <div class="ts" id="linkTs"></div>
        <button class="spot-send" type="submit">送る</button>
        <p class="spot-msg" id="linkMsg" role="status" aria-live="polite"></p>
      </form>
    ) : (
      <p class="spot-wait">受付は準備中です。</p>
    )}
    <details class="spot-privacy">
      <summary>送った内容の扱い</summary>
      <ul>
        <li>送ってもらうのは URL だけです。お名前などは送られません。</li>
        <li>同じ回線から1日10件までの確認のため、IP アドレスを、元に戻せない形（日ごとに変わる鍵でハッシュ化した値）にして2日間だけ使い、そのあと消します。IP アドレスそのものは保存しません。</li>
        <li>同じ URL かどうかの確認のため、URL から作った値を2日間だけ使い、そのあと消します。</li>
        <li>ボット対策に Cloudflare Turnstile を使っています。</li>
      </ul>
    </details>
  </section>
  </Acc>
  <p class="note links-foot">リンク先は、それぞれの運営者のページです。テゲスタ！とは関係ありません。掲載をやめてほしいときは、<a href={href('removal/')}>掲載をやめる依頼</a>から送ってください。</p>
</Base>

<script>
  // ---- 情報提供フォーム（おすすめスポットと同じ受付・同じ Turnstile） ----
  const form = document.getElementById('linkForm') as HTMLFormElement | null;
  if (form) {
    const msg = document.getElementById('linkMsg')!;
    const send = form.querySelector<HTMLButtonElement>('.spot-send')!;
    let token = '';
    let widget: string | undefined;
    const say = (t: string, ok = false) => { msg.textContent = t; msg.classList.toggle('ok', ok); };
    const render = () => {
      if (widget !== undefined) return;
      widget = (window as any).turnstile.render('#linkTs', {
        sitekey: form.dataset.sitekey, action: 'link', language: 'ja', appearance: 'interaction-only',
        callback: (t: string) => { token = t; }, 'expired-callback': () => { token = ''; }, 'error-callback': () => { token = ''; },
      });
    };
    const loadTs = () => {
      if ((window as any).turnstile) { render(); return; }
      if (document.getElementById('ts-js')) return;
      (window as any).onTsLoad = render;
      const s = document.createElement('script');
      s.id = 'ts-js'; s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTsLoad'; s.async = true;
      document.head.append(s);
    };
    new IntersectionObserver((es, io) => { if (es.some(e => e.isIntersecting)) { loadTs(); io.disconnect(); } }, { rootMargin: '400px' }).observe(form);
    form.addEventListener('submit', async e => {
      e.preventDefault();
      const f = new FormData(form);
      const url = String(f.get('url') || '').trim();
      if (!url) { say('URL を入れてください'); return; }
      if (!/^(https?:\/\/)?[^\s/]+\.[^\s/]{2,}/i.test(url)) { say('URL の形になっていないようです（https:// から始まるアドレスを入れてください）'); return; }
      if (!token) { say('確認中です。少し待ってから、もう一度「送る」を押してください'); return; }
      send.disabled = true; say('送っています…');
      try {
        const r = await fetch(form.dataset.api!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ url, website: String(f.get('website') || ''), turnstile: token }), credentials: 'omit', referrerPolicy: 'no-referrer' });
        const d = await r.json().catch(() => ({}));
        if (r.ok && d.ok) { form.reset(); say('ありがとうございます！確認してから載せます。', true); }
        else say(d.error || '送れませんでした。時間をおいて、もう一度お試しください');
      } catch { say('送れませんでした。電波のよいところで、もう一度お試しください'); }
      finally {
        send.disabled = false; token = '';
        try { (window as any).turnstile?.reset(widget); } catch { /* 次の送信で確認し直す */ }
      }
    });
  }
</script>
