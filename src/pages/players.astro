---
import Acc from '../components/Acc.astro';
import Base from '../layouts/Base.astro';
import PostBox from '../components/PostBox.astro';
import { getData, getShareables } from '../lib/data.js';
import { icon, playerUrl, href } from '../lib/util.js';
import { ICON_OF_RECORD, plainTitle } from '../lib/meta.js';
import { SITE } from '../config/site.js';
// 上段：選手名鑑（背番号・プロフィール・称号）／下段：チームデータ（経歴・出身・年齢から作るトピック）
const d = getData();
const facts = getShareables().filter(s => s.kind === 'b');
const ageOf = new Map(d.ages.map(a => [a.name, a.age]));
const known = d.profiles.filter(p => ageOf.get(p.name) !== '' && ageOf.get(p.name) != null);
const ages = known.map(p => Number(ageOf.get(p.name)));
const lo = Math.min(...ages), hi = Math.max(...ages);
const rows = [...d.profiles].sort((a, b) => (b.birth || '0').localeCompare(a.birth || '0'));
const kyushu = ['福岡', '佐賀', '長崎', '熊本', '大分', '宮崎', '鹿児島'];
const pmax = Math.max(...d.prefs.map(p => p.n));
const posCls = p => `pos-${['GK', 'DF', 'MF', 'FW'].includes(p) ? p : 'x'}`;
const urlOf = new Map(d.players.map(p => [p.name, p.jl_url]));
// ランキング3位以内で称号。見せ方で優劣をつけない（並びはランキングの定義順、装飾は全員同じ）
const titles = new Map();
d.rankings.forEach(({ meta, rows }, idx) => {
  if (meta.pair) return;
  for (const r of rows) {
    const list = titles.get(r.name) || titles.set(r.name, []).get(r.name);
    if (meta.warn) { if (r.value >= 3) list.push({ text: plainTitle(meta.title), cls: 'w', id: meta.id, order: 999 }); continue; }
    if (r._rank <= 3) list.push({ text: `${plainTitle(meta.title)} ${r._rank}位`, cls: '', id: meta.id, order: idx, anchor: `ranking/#rank-${meta.id}` });
  }
});
const players = [...d.profiles].sort((a, b) => Number(a.no) - Number(b.no));
---
<Base current="players" title="選手名鑑・チームデータ" description="テゲバジャーロ宮崎の選手名鑑（背番号・年齢・出身地・出身校と今季の称号）と、大学経由・アカデミー育ち・平均年齢などのチームデータ（非公式）。">
  <section class="bday" data-bday hidden></section>
  <Acc id="titles" title="選手名鑑" icon="medal" count={players.length}>
  <section class="card">
    <p class="note">背番号・年齢・出身地・出身校と、今季の称号がひと目でわかる選手カード。称号はランキングで3位以内に入るとゲット。推しの称号をチェックして、応援の話題にどうぞ。名前を押すとJリーグ公式の選手ページ（写真・経歴）が開きます。</p>
    <div class="controls">
      <input id="pq" type="search" placeholder="名前・よみ・ローマ字で検索" aria-label="選手名で検索（漢字・ひらがな・ローマ字）" />
      <div class="seg" id="posSeg" role="group" aria-label="ポジション">
        {['', 'GK', 'DF', 'MF', 'FW'].map((p, i) => <button type="button" data-pos={p} aria-pressed={i === 0 ? 'true' : 'false'}>{p || '全員'}</button>)}
      </div>
      <select id="pOrder" aria-label="並び順"><option value="no">背番号順</option><option value="age">若い順</option><option value="kana">名前順</option></select>
    </div>
    <div class="legend legend-gap">
      {['GK', 'DF', 'MF', 'FW'].map(p => <span class={`pos-${p}`}><i></i>{p}</span>)}
      <span>大きな数字は背番号</span>
    </div>
  </section>
  <div class="grid" id="pGrid">
    {players.map(p => {
      const ts = (titles.get(p.name) || []).sort((a, b) => a.order - b.order);
      const u = playerUrl(urlOf.get(p.name));
      const age = ageOf.get(p.name);
      return (
        <section class={`card pcard reveal pos-${['GK','DF','MF','FW'].includes(p.pos) ? p.pos : 'x'}`} data-name={p.name} data-kana={p.kana || undefined} data-roma={p.romaji || undefined} data-pos={p.pos} data-no={p.no} data-birth={p.birth || undefined} data-age-out={p.birth ? `age-${p.no}` : undefined}>
          <div class="pband">
            <img class="jersey jersey-lg on-color" src={href(`chars/numbers-s/${p.no}.png`)} alt={`背番号${p.no}`} width="72" height="72" loading="lazy" decoding="async" />
            <div>
              <div class="pname">{u ? <a href={u} target="_blank" rel="noopener noreferrer">{p.name}</a> : p.name}</div>
              <div class="pmeta">{p.pos}{age !== '' && age != null && <>・<span id={`age-${p.no}`}>{age}</span>歳</>}{p.birthplace && `・${p.birthplace}出身`}</div>
            </div>
            <span data-bslot="bchip"></span>
          </div>
          <div class="pbody">
            {p.birth && <div class="chips"><button class="chip prof bdbtn" type="button" data-bday-open={p.birth}><Fragment set:html={icon('cake')} />{Number(p.birth.slice(5, 7))}月{Number(p.birth.slice(8))}日生まれ</button></div>}
            {(p.hs_or_youth || p.university) && <div class="chips">{[p.hs_or_youth, p.university].filter(Boolean).map(s => <span class="chip prof"><Fragment set:html={icon('cap')} />{s}</span>)}</div>}
            {ts.length > 0 && <div class="chips">{ts.map(t => t.anchor
              ? <a class={`chip ${t.cls}`} href={href(t.anchor)}><Fragment set:html={icon(ICON_OF_RECORD[t.id] || 'star')} />{t.text}</a>
              : <span class={`chip ${t.cls}`}><Fragment set:html={icon(ICON_OF_RECORD[t.id] || 'star')} />{t.text}</span>)}</div>}
          </div>
        </section>
      );
    })}
  </div>
  </Acc>
  <Acc id="ages" title="年齢一覧" icon="cake" count={rows.length}>
  <section class="card">
    <p class="note">今日時点の満年齢。左の数字が並び順で、上から順に読みます（2段のときは左の段の下から右の段へ続きます）。ピンクの枠は1か月以内に誕生日を迎える選手です。</p>
    <div class="controls gap">
      <div class="seg" id="ageSeg" role="group" aria-label="並び順">
        {[['young', '若い順'], ['old', '年上順'], ['no', '背番号順'], ['bday', '誕生日が近い順']].map(([v, l], i) => <button type="button" data-ord={v} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}
      </div>
      <div class="seg" id="agePos" role="group" aria-label="ポジション">
        {['', 'GK', 'DF', 'MF', 'FW'].map((p, i) => <button type="button" data-pos={p} aria-pressed={i === 0 ? 'true' : 'false'}>{p || '全員'}</button>)}
      </div>
    </div>
    <ol class="ages" id="ageList">
      {rows.map(p => { const a = ageOf.get(p.name); const has = a !== '' && a != null; const [y, m, dd] = (p.birth || '').split('-'); return (
        <li class={posCls(p.pos)} data-no={p.no} data-pos={p.pos} data-birth={p.birth || undefined} data-age-out={p.birth ? `ag-${p.no}` : undefined}>
          <span class={`bar w${has && hi > lo ? Math.round(20 + 80 * (Number(a) - lo) / (hi - lo)) : 0}`}></span>
          <img class="jersey jersey-sm" src={href(`chars/numbers-s/${p.no}.png`)} alt={`背番号${p.no}`} width="44" height="44" loading="lazy" decoding="async" />
          <span class="nm">{p.name}<span data-bslot="soon"></span><small>{p.pos}{p.birth && <>・<button class="bdbtn" type="button" data-bday-open={p.birth}><Fragment set:html={icon('cake')} />{Number(y)}年{Number(m)}月{Number(dd)}日生まれ</button></>}</small></span>
          <span class="ag">{has ? <><span id={`ag-${p.no}`}>{a}</span><small>歳</small></> : '—'}</span>
        </li>); })}
    </ol>
  </section>
  </Acc>
  <Acc id="prefs" title="出身都道府県" icon="pin" count={d.prefs.length}>
    <section class="card prefs">
      <p class="note">都道府県ごとの人数（ピンクは九州）。バーにカーソルを重ねる（スマホはタップ）と、その出身の選手が出ます。</p>
      {d.prefs.map(p => (
        <div class={`row pref-row ${kyushu.includes(p.pref) ? 'ky' : ''}`} tabindex="0" role="button" aria-label={`${p.pref}出身 ${p.n}人：${d.profiles.filter(x => x.birthplace === p.pref).map(x => x.name).join('・')}`}>
          <span>{p.pref}</span><span class={`bar2 w${Math.round(p.n / pmax * 100)}`}></span><span>{p.n}</span>
          <span class="pref-tip" aria-hidden="true"><b>{p.pref}出身</b>{d.profiles.filter(x => x.birthplace === p.pref).map(x => <span class="nm">{x.name}</span>)}</span>
        </div>))}
    </section>
  </Acc>
  <Acc id="links" title="同じ母校・ユース出身" icon="link" count={d.school_links.length}>
    <section class="card">
      <p class="note">高校・ユース・大学が同じ選手。宮崎でまた同じピッチに。</p>
      <table class="simple"><thead><tr><th>学校・ユース</th><th>選手</th></tr></thead>
        <tbody>{d.school_links.map(r => <tr><td>{r.school}</td><td>{r.members}</td></tr>)}</tbody></table>
    </section>
  </Acc>
  <Acc id="roots" title="チームデータ" icon="suitcase" count={facts.length}>
  <div class="grid">
    {facts.map(f => (
      <article class={`card fact reveal vt-b-${f.id}`} id={`b-${f.id}`}>
        <div class="label"><Fragment set:html={icon(f.icon)} />{f.label}</div>
        <a class="big factlink" href={href(`b/${f.id}/`)} data-count>{f.big}</a>
        <div class="hl">{f.headline}</div>
        <div class="sub">{f.sub}</div>
        <p class="cheer">{f.cheer}</p>
        <PostBox what={f.label} text={f.text} url={`${SITE.url}/b/${f.id}/`} />
      </article>
    ))}
  </div>
  </Acc>
</Base>
<style>
  .sec-h { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-top: 4px; }
  .sec-h h2 { margin: 0; font-size: 1.15rem; }
  .sec-h a { font-size: .85rem; white-space: nowrap; }
  .two { grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .gap { margin-bottom: 10px; }
  .factlink { text-decoration: none; }

  .legend-gap { margin-top: 10px; }
  a.chip { color: inherit; text-decoration: none; }
  a.chip:hover { border-color: var(--brand); color: var(--ink); }
</style>
<script>
  import { nameKeys, matchName } from '../lib/namesearch.js';
  // ---- 年齢一覧 ----
  {
  const list = document.getElementById('ageList')!;
  const items = [...list.querySelectorAll<HTMLElement>('li')];
  let ord = 'young', pos = '';
  const daysTo = (b?: string) => {
    if (!b) return 999;
    const [, m, d] = b.split('-').map(Number);
    const t = new Date(new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo' }).format(new Date()) + 'T00:00:00Z');
    let n = Date.UTC(t.getUTCFullYear(), m - 1, d); if (n < +t) n = Date.UTC(t.getUTCFullYear() + 1, m - 1, d);
    return Math.round((n - +t) / 86400000);
  };
  const draw = () => {
    [...items].sort((a, b) => {
      if (ord === 'no') return Number(a.dataset.no) - Number(b.dataset.no);
      if (ord === 'bday') return daysTo(a.dataset.birth) - daysTo(b.dataset.birth);
      const x = a.dataset.birth || '', y = b.dataset.birth || '';
      if (!x || !y) return x ? -1 : y ? 1 : 0;
      return ord === 'young' ? y.localeCompare(x) : x.localeCompare(y);
    }).forEach(e => { e.hidden = !!pos && e.dataset.pos !== pos; list.append(e); });
  };
  const bind = (id: string, key: string, fn: (v: string) => void) => {
    const s = document.getElementById(id)!;
    s.addEventListener('click', e => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      fn(b.dataset[key] || '');
      s.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
      draw();
    });
  };
  bind('ageSeg', 'ord', v => { ord = v; });
  bind('agePos', 'pos', v => { pos = v; });
  }
  // ---- 選手の称号 ----
  {
  const grid = document.getElementById('pGrid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.pcard')];
  const keys = new Map(cards.map(c => [c, nameKeys({ name: c.dataset.name, kana: c.dataset.kana, romaji: c.dataset.roma })]));
  const q = document.getElementById('pq') as HTMLInputElement;
  const ord = document.getElementById('pOrder') as HTMLSelectElement;
  const seg = document.getElementById('posSeg')!;
  let pos = '';
  const drawCards = () => {
    const s = q.value.trim();
    const sorted = [...cards].sort((a, b) => {
      if (ord.value === 'age') return (a.dataset.birth ? -1 : 1) - (b.dataset.birth ? -1 : 1) || String(b.dataset.birth).localeCompare(String(a.dataset.birth)) || Number(a.dataset.no) - Number(b.dataset.no);
      if (ord.value === 'kana') return String(a.dataset.kana || a.dataset.name).localeCompare(String(b.dataset.kana || b.dataset.name), 'ja');
      return Number(a.dataset.no) - Number(b.dataset.no);
    });
    sorted.forEach((c, i) => { c.style.order = String(i); c.hidden = (!!s && !matchName(keys.get(c)!, s)) || (!!pos && c.dataset.pos !== pos); });
  };
  q.addEventListener('input', drawCards); ord.addEventListener('change', drawCards);
  seg.addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    pos = b.dataset.pos || '';
    seg.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    drawCards();
  });
  }
  // 出身地：スマホ（カーソルのない端末）はタップで吹き出しを開く。ほかを押すと閉じる（PC はカーソルを重ねると CSS で出る）
  {
    const rows = [...document.querySelectorAll<HTMLElement>('.pref-row')];
    const close = (except?: HTMLElement) => rows.forEach(r => { if (r !== except) r.classList.remove('is-open'); });
    rows.forEach(r => {
      r.addEventListener('click', e => { if (matchMedia('(hover: hover)').matches) return; e.stopPropagation(); const on = !r.classList.contains('is-open'); close(r); r.classList.toggle('is-open', on); });
      r.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); const on = !r.classList.contains('is-open'); close(r); r.classList.toggle('is-open', on); } if (e.key === 'Escape') close(); });
    });
    document.addEventListener('click', () => close());
  }
</script>
