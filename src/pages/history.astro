---
import Base from '../layouts/Base.astro';
import Acc from '../components/Acc.astro';
import { SITE } from '../config/site.js';
import { getData } from '../lib/data.js';
import { loadHistory, record, scorers, COMP } from '../lib/clubhistory.js';
import { renderRecords, pickKind } from '../lib/hsrecords.js';
import { playerUrl } from '../lib/util.js';
// 歴史：Jリーグに入った2021年からの全試合と、通算の記録
const d = getData();
const { matches, seasons } = loadHistory();
const urlOf = new Map(d.players.map(p => [p.name, playerUrl(p.jl_url)]));
const md = s => { const [, m, dd] = s.split('-').map(Number); return `${m}/${dd}`; };
const resCls = { 勝: 'win', 分: 'draw', 負: 'lose' };
const haWord = h => (h === 'H' ? 'ホーム' : 'アウェイ');
const score = m => `${m.gf}-${m.ga}${m.pk ? `（PK ${m.pk[0]}-${m.pk[1]}）` : m.et ? '（延長）' : ''}`;
const label = m => (COMP[m.comp].league ? `第${m.round}節` : `${COMP[m.comp].name} ${m.round}`);
// シーズンごと（新しい順）。順位は history_seasons.csv、今季の順位は site.js
const bySeason = seasons.map(s => {
  const ms = matches.filter(m => m.season === s.season);
  const lg = ms.filter(m => m.season === '2026特別' ? m.comp === 'j2j3' && /WEST-B/.test(m.round) : m.league);
  const rank = s.season === '2026/27' ? String(SITE.rank) : s.rank;
  // 試合は新しい順（上がいちばん新しい）
  return { ...s, rank, ms: [...ms].reverse(), rec: record(lg), top: scorers(lg)[0], cups: ms.filter(m => !lg.includes(m)) };
}).reverse();
// 年表：1行ずつ
const timeline = [
  { y: '2021', t: 'J3リーグに参入。1年目で3位' },
  { y: '2025', t: 'J3リーグ4位からJ2昇格プレーオフへ。準決勝で鹿児島に2-0、決勝でFC大阪に4-0で勝ち、クラブ初のJ2昇格' },
  { y: '2026', t: 'シーズン移行前の特別大会「百年構想リーグ」で地域リーグラウンド WEST-B 1位。プレーオフラウンドを経て最終3位' },
  { y: '2026/27', t: `J2リーグ1年目。${SITE.roundLabel}時点で${SITE.rank}位` },
];
// 順位の推移（リーグ戦）。縦が順位（上が1位）。リーグがちがう年は下に書く
const chart = bySeason.filter(s => s.season !== '2026特別' && s.rank).reverse();
// スマホでも字が小さくならないよう、横幅をせまめに描いて広げる
const CW = 420, CH = 230, PL = 40, PR = 30, PT = 24, PB = 42;
const maxTeams = Math.max(...chart.map(s => Number(s.teams)));
const xOf = i => PL + (CW - PL - PR) * (chart.length === 1 ? .5 : i / (chart.length - 1));
const yOf = r => PT + (CH - PT - PB) * ((Number(r) - 1) / (maxTeams - 1));
const pts = chart.map((s, i) => ({ s, x: xOf(i), y: yOf(s.rank) }));
// 通算の記録：どの試合で数えるか（シーズン × 種類）を選ぶ。はじめは全シーズンのすべての公式戦（リーグ戦以外も含める）
// ブラウザで選びなおせるよう、試合の要点を JSON にしてページに入れる（計算と表示は hsrecords.js を共用）
const playerUrls = Object.fromEntries([...urlOf].filter(([, u]) => u));
const slim = matches.map(m => ({ date: m.date, season: m.season, comp: m.comp, round: m.round, ha: m.ha, opponent: m.opponent, oppFull: m.oppFull, oppUrl: m.oppUrl,
  gf: m.gf, ga: m.ga, att: m.att, result: m.result, league: m.league, goals: m.goals.map(g => ({ scorer: g.og ? '' : g.scorer, og: g.og })) }));
const hsJson = JSON.stringify({ m: slim, p: playerUrls }).replace(/</g, '\\u003c');
const KINDS = [['all', 'すべて'], ['league', 'リーグ戦（J3・J2）'], ['other', 'リーグ戦以外']];
const firstHtml = renderRecords(pickKind(matches, 'all'), { playerUrl: playerUrls });
---
<Base current="history" title="歴史・全試合の記録" description={`テゲバジャーロ宮崎の歴史。Jリーグに入った2021年からの全試合の結果・得点者と、シーズンごとの順位、相手ごとの対戦成績、通算得点ランキング（非公式）。${SITE.roundLabel}時点。`}>
  <section class="card hs-intro">
    <h2 class="hs-h">年表</h2>
    <ol class="hs-tl">
      {timeline.map(t => <li><span class="hs-y">{t.y}</span><span>{t.t}</span></li>)}
    </ol>
    <p class="note">2021年より前（九州リーグ・JFL）の年ごとの順位は、出典を確かめてから載せます。</p>
  </section>

  <Acc id="rank" title="順位の推移" icon="chartup" note="リーグ戦の最終順位">
    <div class="card hs-chart">
      <svg viewBox={`0 0 ${CW} ${CH}`} role="img" aria-label={chart.map(s => `${s.label}年 ${s.league} ${s.rank}位`).join('、')}>
        {[1, 5, 10, 15, 20].filter(r => r <= maxTeams).map(r => <g class="hs-grid"><line x1={PL} x2={CW - PR} y1={yOf(r)} y2={yOf(r)} /><text x={PL - 6} y={yOf(r) + 4}>{r}</text></g>)}
        <polyline class="hs-lineplot" points={pts.map(p => `${p.x},${p.y}`).join(' ')} />
        {pts.map(p => (
          <g class={`hs-pt${p.s.league === 'J2' ? ' j2' : ''}`}>
            <circle cx={p.x} cy={p.y} r="6" />
            <text class="hs-rk" x={p.x} y={p.y - 12}>{p.s.rank}位</text>
            <text class="hs-yr" x={p.x} y={CH - 20}>{p.s.label}</text>
            <text class="hs-lg" x={p.x} y={CH - 4}>{p.s.league}{p.s.season === '2026/27' ? '（途中）' : ''}</text>
          </g>
        ))}
      </svg>
    </div>
  </Acc>

  <Acc id="seasons" title="シーズンごとの全試合" icon="calendar" count={bySeason.length}>
    <div class="hs-seasons">
      {bySeason.map((s, i) => (
        <details class="card hs-season" open={i === 0}>
          <summary class="hs-sum">
            <span class="hs-sy">{s.label}</span>
            <span class="hs-sl">{s.league}</span>
            {s.rank && <span class="hs-sr">{s.rank}位{s.season === '2026/27' ? '（途中）' : ''}</span>}
            <span class="hs-sw">{s.rec.w}勝{s.rec.d}分{s.rec.l}敗</span>
          </summary>
          <p class="hs-meta">勝ち点{s.rec.pts}・{s.rec.gf}得点{s.rec.ga}失点{s.top && <>・チーム得点王 {urlOf.get(s.top.name) ? <a href={urlOf.get(s.top.name)} target="_blank" rel="noopener noreferrer">{s.top.name}</a> : s.top.name}（{s.top.goals}点）</>}{s.note && <>・{s.note}</>}</p>
          <ul class="hs-list">
            {s.ms.map(m => (
              <li class="hs-row">
                <span class="hs-d">{md(m.date)}</span>
                <span class="hs-c">{label(m)}</span>
                <span class="hs-o"><a class="club-link" href={m.oppUrl} target="_blank" rel="noopener noreferrer">{m.oppFull}</a><small>（{haWord(m.ha)}）</small></span>
                <a class={`lu-res hs-res ${resCls[m.result]}`} href={m.url} target="_blank" rel="noopener noreferrer" aria-label={`${m.oppFull}戦 ${score(m)}（Jリーグ公式の試合ページ）`}>{score(m)}</a>
                {m.goals.length > 0 && <span class="hs-g">{m.goals.map(g => `${g.og ? 'オウンゴール' : g.scorer}${g.minute}'`).join('・')}</span>}
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </Acc>

  <Acc id="records" title="通算の記録" icon="trophy">
    <div class="controls hs-scope">
      <select id="hsSeason" aria-label="シーズン">
        <option value="">全シーズン（2021年〜）</option>
        {bySeason.map(x => <option value={x.season}>{x.season === '2026特別' ? '2026 百年構想リーグ' : x.label}</option>)}
      </select>
      <div class="seg" id="hsKind" role="group" aria-label="数える試合の種類">
        {KINDS.map(([k, name], i) => <button type="button" data-kind={k} aria-pressed={i === 0 ? 'true' : 'false'}>{name}</button>)}
      </div>
    </div>
    <p class="note hs-kindnote">通算の記録は、リーグ戦（J3・J2）だけでなく、リーグ戦以外の公式戦（J2昇格プレーオフ・百年構想リーグ・天皇杯・ルヴァンカップ）も含めて数えています。シーズンや種類を選ぶと、その試合だけで数えなおします。PK戦で決まった試合は引き分けで数えます。</p>
    <div id="hsRec" class="hs-scopebox" aria-live="polite" set:html={firstHtml}></div>
    <script type="application/json" id="hsData" set:html={hsJson}></script>
  </Acc>
  <p class="note hs-src">試合の結果・得点者・観客数は<a href="https://www.jleague.jp/club/miyazaki/day/" target="_blank" rel="noopener noreferrer">Jリーグ公式サイト</a>、シーズンの順位は<a href="https://www.football-lab.jp/myzk/season/" target="_blank" rel="noopener noreferrer">Football LAB</a>から。天皇杯は、本大会に出た2023・2024・2026年の試合です。天皇杯の「ホーム／アウェイ」は、Jリーグ公式の表記に合わせています（宮崎で行った試合でも、相手のホーム扱いのことがあります）。</p>
</Base>
<script>
  // 通算の記録：シーズン × 種類で数えなおす（hsrecords.js をブラウザでも使う）
  import { renderRecords, pickKind } from '../lib/hsrecords.js';
  const data = JSON.parse(document.getElementById('hsData')!.textContent || '{}');
  const box = document.getElementById('hsRec')!, sel = document.getElementById('hsSeason') as HTMLSelectElement, kseg = document.getElementById('hsKind')!;
  let kind = 'all';
  const draw = () => {
    const ms = data.m.filter((m: any) => !sel.value || m.season === sel.value);
    box.innerHTML = renderRecords(pickKind(ms, kind), { playerUrl: data.p });
  };
  sel.addEventListener('change', draw);
  kseg.addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-kind]'); if (!b) return;
    kind = b.dataset.kind!;
    kseg.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    draw();
  });
  // 対戦成績：打つそばから絞り込む＋勝ち越し・五分・負け越しで絞り込む（中身を作りなおしても効くよう、箱で受ける）
  let tilt = '';
  const apply = () => {
    const inp = box.querySelector<HTMLInputElement>('.hs-search');
    const q = (inp?.value || '').normalize('NFKC').trim().toLowerCase();
    box.querySelectorAll<HTMLElement>('.hs-h2h li[data-name]').forEach(li => {
      li.hidden = (!!q && !li.dataset.name!.normalize('NFKC').toLowerCase().includes(q)) || (!!tilt && li.dataset.tilt !== tilt);
    });
  };
  box.addEventListener('input', e => { if ((e.target as HTMLElement).matches('.hs-search')) apply(); });
  box.addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.hs-tilt button[data-tilt]'); if (!b) return;
    tilt = b.dataset.tilt || '';
    b.parentElement!.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    apply();
  });
  // 作りなおしたら、絞り込みは「すべて」に戻す
  new MutationObserver(() => { tilt = ''; }).observe(box, { childList: true });
</script>
