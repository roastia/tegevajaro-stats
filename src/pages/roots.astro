---
// 「選手の背景」は「選手」のページの上段にまとめた。前のURL（共有されたリンク）は新しいページへ移す
import { href } from '../lib/util.js';
const to = href('players/');
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content={`0; url=${to}`} />
  <link rel="canonical" href={to} />
  <title>選手｜テゲスタ！</title>
</head>
<body><p><a href={to}>「選手」のページへ移りました</a></p></body>
</html>
