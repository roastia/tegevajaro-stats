---
import Base from '../layouts/Base.astro';
import Acc from '../components/Acc.astro';
import { readCsv } from '../lib/data.js';
import { icon, href, xUrl, mapsUrl, siteUrl, STADIUM, distanceKm, distanceLabel, SPOT_GENRES } from '../lib/util.js';
import { SITE } from '../config/site.js';
// 載せるのは、こちらで確認して src/data/spots.csv に入れたものだけ（投稿はそのままは出さない）
// スタジアムから近い順に並べ、直線距離を出す。公式サイトと Google マップは別のボタン
const spots = readCsv('spots').filter(s => s.name && s.lat !== '' && s.lng !== '')
  .map(s => { const km = distanceKm(STADIUM.lat, STADIUM.lng, +s.lat, +s.lng); return { ...s, x: xUrl(s.x_handle), maps: mapsUrl(s.lat, s.lng, s.name, s.place_id), site: siteUrl(s.url), km, dist: distanceLabel(km) }; })
  .sort((a, b) => a.km - b.km);
const genres = SPOT_GENRES.map(g => ({ g, c: spots.filter(s => s.genre === g).length })).filter(x => x.c);
const ready = !!(SITE.spots.api && SITE.spots.turnstileSiteKey);
// ハート（ログインなしで押せる。数は出さず、多い順に並べかえるだけ）。受付（Cloudflare Workers）があるときだけみんなの分で並ぶ
const heartsApi = SITE.spots.api ? new URL('/api/hearts', SITE.spots.api).href : '';
const HEART = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20 4.3 12.3A4.88 4.88 0 0 1 11.2 5.4L12 6.2l.8-.8a4.88 4.88 0 0 1 6.9 6.9z"/></svg>';
---
<Base current="spots" title="みやざき情報・アウェイ観戦ガイド" description="テゲバジャーロ宮崎のホーム、いちご宮崎新富サッカー場へのアクセス・スタグル・観戦ルールの案内（公式ページへのリンク）と、テゲサポおすすめの宮崎のスポット（非公式）。">
  <section class="miya-hero">
    <h2 class="welcome-h welcome-img"><img src={href('welcome-miyazaki.svg')} alt="ようこそみやざきへ！" width="2020" height="301" /></h2>
    <p>遠くから、ようこそお越しくださいました！試合の前も後も、宮崎をゆっくり楽しんでいってください。スタジアムへの行きかたや観戦ルールなどの案内と、地元のテゲサポがおすすめする場所をまとめました。「また来たいな」と思ってもらえたら、うれしいです。</p>
    <div class="miya-acts">
      <a class="btn-main" href="#spotList"><Fragment set:html={icon('pin')} />おすすめスポットを見る</a>
      <a class="btn-sub" href="#post">おすすめを教える</a>
    </div>
  </section>

  <Acc id="spotList" title="おすすめスポット" icon="pin" count={spots.length || ''}>
  <section class="card">

    {spots.length > 0
      ? <>
          <p class="note">気に入った場所は、ハートで応援！</p>
          <div class="controls spot-ctl">
            <input id="sq" type="search" placeholder="名前・よみ・ローマ字で検索" aria-label="スポットの名前で検索（漢字・ひらがな・ローマ字）" />
            {genres.length > 1 && <div class="seg" id="genreSeg" role="group" aria-label="ジャンル">
              <button type="button" data-genre="" aria-pressed="true">すべて</button>
              {genres.map(x => <button type="button" data-genre={x.g} aria-pressed="false">{x.g}</button>)}
            </div>}
          </div>
          <p class="note spot-none" id="spotNone" hidden>見つかりませんでした。ほかの言葉やジャンルで探してみてください。</p>
        </>
      : <div class="spot-empty"><p>まだありません。最初のおすすめを教えてください！</p><a class="btn-main" href="#post">おすすめを教える</a></div>}
    {spots.length > 0 && (
      <ul class="spot-list" id="spotUl" data-hearts={heartsApi || undefined}>
        {spots.map(s => (
          <li id={`spot-${s.id}`} data-id={s.id} data-name={s.name} data-kana={s.kana || undefined} data-genre={s.genre || undefined}>
            <button class="spot-heart" type="button" data-heart={s.id} aria-pressed="false" aria-label={`${s.name}にハート`}><Fragment set:html={HEART} /></button>
            {/* ふだんは「ハート・名前・スタジアムからの距離・開く印」の1行だけ。押すと、ひとこと・リンクが開く（1画面にたくさん並べるため） */}
            <details class="spot-d">
              <summary class="spot-sum"><span class="spot-row"><b class="spot-name">{s.name.split(/[ 　]+/).map((w, i) => <>{i > 0 && ' '}<span class="nw spot-np">{w}</span></>)}</b><span class="spot-km" aria-label={`スタジアムから${s.dist}`}><Fragment set:html={icon('stadium')} />{s.dist}</span><span class="spot-more" aria-hidden="true"></span></span></summary>
              <div class="spot-body">
                <div class="spot-go">
                  {s.genre && <span class="chip spot-g">{s.genre}</span>}
                  <span class="spot-info">{s.info}</span>
                </div>
                <div class="spot-links">
                  {s.site && <a class="spot-btn" href={s.site} target="_blank" rel="noopener noreferrer">公式サイト<span aria-hidden="true">↗</span></a>}
                  <a class="spot-btn" href={s.maps} target="_blank" rel="noopener noreferrer">Googleマップ<span aria-hidden="true">↗</span></a>
                </div>
                {s.x && <p class="spot-by">教えてくれた人<a class="spot-btn" href={s.x} target="_blank" rel="noopener noreferrer nofollow ugc" aria-label={`教えてくれた人 @${s.x_handle} さんの X アカウントを開く`}>@{s.x_handle}</a></p>}
                <p class="spot-rm"><a href={href(`removal/?item=${s.id}`)}>掲載をやめる依頼</a></p>
              </div>
            </details>
          </li>
        ))}
      </ul>
    )}
  </section>
  </Acc>

  <Acc id="post" title="おすすめを教えて！" icon="sparkle">
  <section class="card spot-form-card">

    <p class="spot-ask">お店だけじゃなくて、宮崎のいいところなら何でも大歓迎。アウェイから来たみなさんに、見てほしい・食べてほしい・知ってほしい場所を教えてください！</p>
    <p class="spot-examples"><b>たとえば</b>ごはん・カフェ／海や山の景色／神社・観光地／温泉・銭湯／お土産が買えるお店／試合の前後にちょっと寄れる場所</p>
    <details class="spot-privacy spot-rules">
      <summary>投稿のルール</summary>
      <ul>
        <li>送ってもらった内容は、すぐにはページに載りません。確認してから、このページに載せます。</li>
        <li>載せるかどうか・載せる文面は、こちらで判断します（個人のお宅、宣伝、悪口などは載せません）。ひとことは、短く整えたり書き換えたりすることがあります。</li>
        <li>同じ回線（Wi-Fi など）からの投稿は1日10件まで、同じ内容は1回だけ受け付けます。</li>
        <li>あとで X のユーザー名を変えても、掲載済みの表示は変更できません。ごめんなさい。</li>
        <li>載せた内容を消してほしいときは、各スポットの「掲載をやめる依頼」から送ってください。理由は問わず、確認できしだい取り下げます。</li>
      </ul>
    </details>
    {ready ? (
      <form class="spot-form" id="spotForm" novalidate data-api={SITE.spots.api} data-sitekey={SITE.spots.turnstileSiteKey}>
        <label>場所の名前<span class="req">必須</span><input name="name" required maxlength="60" autocomplete="off" placeholder="例：〇〇食堂・〇〇神社・〇〇海岸" /></label>
        <label>ひとこと<span class="req">必須</span><textarea name="info" required maxlength="300" rows="3" aria-describedby="infoHint" placeholder="例：新富町の国道沿い。試合前に寄りたい、チキン南蛮がおいしいお店"></textarea></label>
        <p class="note field-hint" id="infoHint">同じ名前の場所がほかにあるかもしれないので、場所がわかる特徴（町名・近くの目印・どんな場所か など）も書いてください。</p>
        <label>あなたの X のユーザー名<span class="opt">任意</span><span class="xin"><span class="at" aria-hidden="true">@</span><input name="x_handle" maxlength="16" autocomplete="off" autocapitalize="off" spellcheck="false" inputmode="latin" aria-describedby="xHint" placeholder="tegesapo" /></span></label>
        <p class="note field-hint" id="xHint">X のプロフィールで「@」のあとに出ている英数字です（@tegesapo なら tegesapo）。入れると「教えてくれた人 <span class="nw">@〇〇</span>」として載ります。空のままでも送れます。</p>
        <div class="hp" aria-hidden="true"><label>ウェブサイト<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <div class="ts" id="spotTs"></div>
        <button class="spot-send" type="submit">送る</button>
        <p class="spot-msg" id="spotMsg" role="status" aria-live="polite"></p>
      </form>
    ) : (
      <p class="spot-wait">投稿フォームは準備中です。</p>
    )}
    <details class="spot-privacy">
      <summary>送った内容の扱い</summary>
      <ul>
        <li>送ってもらうのは「場所の名前・ひとこと・X のユーザー名（任意）」だけです。</li>
        <li>同じ回線から1日10件までの確認のため、IP アドレスを、元に戻せない形（日ごとに変わる鍵でハッシュ化した値）にして2日間だけ使い、そのあと消します。IP アドレスそのものは保存しません。</li>
        <li>同じ内容の投稿かどうかの確認のため、場所の名前とひとことから作った値を2日間だけ使い、そのあと消します。</li>
        <li>ボット対策に Cloudflare Turnstile を使っています。</li>
      </ul>
    </details>
  </section>
  </Acc>


  <Acc id="away" title="アウェイからお越しのみなさんへ" icon="plane">
  <section class="card away-guide" aria-label="アウェイからお越しのみなさんへ">

    <ul class="ag-tiles">
      <li>
        <span class="ag-ic"><Fragment set:html={icon('pin')} /></span>
        <b>スタジアム</b>
        <p>いちご宮崎新富サッカー場（宮崎県児湯郡新富町）</p>
        <a class="ag-btn" href="https://www.google.com/maps/search/?api=1&amp;query=32.0737818,131.4909384" target="_blank" rel="noopener noreferrer">地図を開く</a>
      </li>
      <li>
        <span class="ag-ic"><Fragment set:html={icon('plane')} /></span>
        <b>アクセス</b>
        <p>飛行機・電車・車でのお越しかたと駐車場の案内は、クラブ公式のアクセスページにまとまっています。</p>
        <a class="ag-btn" href="https://www.tegevajaro.com/club/stadium/access" target="_blank" rel="noopener noreferrer">アクセス・駐車場</a>
      </li>
      <li>
        <span class="ag-ic"><Fragment set:html={icon('food')} /></span>
        <b>スタグル</b>
        <p>スタジアムグルメ（スタグル）の出店情報は、クラブ公式サイトのお知らせで確認できます。</p>
        <a class="ag-btn" href="https://www.tegevajaro.com/" target="_blank" rel="noopener noreferrer">クラブ公式サイト</a>
      </li>
      <li>
        <span class="ag-ic"><Fragment set:html={icon('flag')} /></span>
        <b>観戦ルール</b>
        <p>入場や応援のルールは、クラブ公式の観戦ガイドで確認できます。</p>
        <a class="ag-btn" href="https://www.tegevajaro.com/news/850" target="_blank" rel="noopener noreferrer">観戦ガイド</a>
      </li>
      <li>
        <span class="ag-ic"><Fragment set:html={icon('calendar')} /></span>
        <b>来場案内</b>
        <p>試合ごとの来場案内（マッチデーガイド）は、クラブ公式サイトのお知らせに出ます。</p>
        <a class="ag-btn" href="https://www.tegevajaro.com/" target="_blank" rel="noopener noreferrer">クラブ公式サイト</a>
      </li>
    </ul>
  </section>
  </Acc>
</Base>

<script>
  import { nameKeys, matchName } from '../lib/namesearch.js';
  // ---- 名前検索（打つそばから絞り込む）とジャンル ----
  {
    const ul = document.getElementById('spotUl');
    const q = document.getElementById('sq') as HTMLInputElement | null;
    if (ul && q) {
      const items = [...ul.querySelectorAll<HTMLElement>(':scope > li')];
      const keys = new Map(items.map(li => [li, nameKeys({ name: li.dataset.name, kana: li.dataset.kana })]));
      const seg = document.getElementById('genreSeg');
      const none = document.getElementById('spotNone')!;
      let genre = '';
      const draw = () => {
        const s = q.value.trim();
        let shown = 0;
        for (const li of items) { li.hidden = (!!s && !matchName(keys.get(li)!, s)) || (!!genre && li.dataset.genre !== genre); if (!li.hidden) shown++; }
        none.hidden = shown > 0;
      };
      q.addEventListener('input', draw);
      seg?.addEventListener('click', e => {
        const b = (e.target as HTMLElement).closest('button'); if (!b) return;
        genre = b.dataset.genre || '';
        seg.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
        draw();
      });
    }
  }
  // ---- ハート：押すと塗りつぶし（この端末に覚える）。受付があれば送って、みんなのハートが多い順に並べかえる ----
  {
    const ul = document.getElementById('spotUl');
    if (ul) {
      const api = ul.dataset.hearts || '';
      const KEY = (id: string) => `tg:heart:${id}`;
      const get = (id: string) => { try { return localStorage.getItem(KEY(id)) === '1'; } catch { return false; } };
      const put = (id: string, on: boolean) => { try { on ? localStorage.setItem(KEY(id), '1') : localStorage.removeItem(KEY(id)); } catch { /* 覚えられなくても押せる */ } };
      // #spot-〇〇 へのリンクで来たら、そのスポットを開いておく
      const hashOpen = () => { const li = location.hash.startsWith('#spot-') ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null; li?.querySelector('details')?.setAttribute('open', ''); };
      hashOpen(); addEventListener('hashchange', hashOpen);
      const btns = [...ul.querySelectorAll<HTMLButtonElement>('[data-heart]')];
      for (const b of btns) b.setAttribute('aria-pressed', String(get(b.dataset.heart!)));
      ul.addEventListener('click', e => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-heart]'); if (!b) return;
        const id = b.dataset.heart!, on = b.getAttribute('aria-pressed') !== 'true';
        b.setAttribute('aria-pressed', String(on)); put(id, on);
        b.classList.remove('pop'); void b.offsetWidth; if (on) b.classList.add('pop');
        if (api) fetch(api, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, on }), keepalive: true }).catch(() => {});
      });
      // 並べかえ（ハートが多い順。返ってこなかった場所は、いまの順＝スタジアムから近い順のまま後ろに）
      if (api) fetch(api).then(r => r.ok ? r.json() : null).then(d => {
        const order: string[] = Array.isArray(d?.order) ? d.order : [];
        if (!order.length) return;
        const rank = new Map(order.map((id, i) => [id, i]));
        const items = [...ul.children] as HTMLElement[];
        items.map((li, i) => ({ li, i, r: rank.has(li.dataset.id!) ? rank.get(li.dataset.id!)! : Infinity }))
          .sort((a, b) => a.r - b.r || a.i - b.i).forEach(x => ul.appendChild(x.li));
      }).catch(() => {});
    }
  }

  // ---- 投稿フォーム ----
  const form = document.getElementById('spotForm') as HTMLFormElement | null;
  if (form) {
    const msg = document.getElementById('spotMsg')!;
    const send = form.querySelector<HTMLButtonElement>('.spot-send')!;
    let token = '';
    let widget: string | undefined;
    const say = (t: string, ok = false) => { msg.textContent = t; msg.classList.toggle('ok', ok); };
    // Turnstile（ボット対策）は、フォームが画面に近づいたら読み込む
    const render = () => {
      if (widget !== undefined) return;
      widget = (window as any).turnstile.render('#spotTs', {
        sitekey: form.dataset.sitekey, action: 'spot', language: 'ja', appearance: 'interaction-only',
        callback: (t: string) => { token = t; }, 'expired-callback': () => { token = ''; }, 'error-callback': () => { token = ''; },
      });
    };
    const loadTs = () => {
      if ((window as any).turnstile) { render(); return; }
      if (document.getElementById('ts-js')) return;
      (window as any).onTsLoad = render;
      const s = document.createElement('script');
      s.id = 'ts-js'; s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTsLoad'; s.async = true;
      document.head.append(s);
    };
    new IntersectionObserver((es, io) => { if (es.some(e => e.isIntersecting)) { loadTs(); io.disconnect(); } }, { rootMargin: '400px' }).observe(form);

    form.addEventListener('submit', async e => {
      e.preventDefault();
      const f = new FormData(form);
      const body = Object.fromEntries(['name', 'info', 'x_handle', 'website'].map(k => [k, String(f.get(k) || '')]));
      if (!body.name.trim() || !body.info.trim()) { say('「場所の名前」と「ひとこと」を入れてください'); return; }
      body.x_handle = body.x_handle.trim().replace(/^[@＠]/, '');
      if (body.x_handle && !/^[A-Za-z0-9_]{1,15}$/.test(body.x_handle)) { say('X のユーザー名は「@」のあとの英数字（と _）を15文字まで入れてください'); return; }
      if (!token) { say('確認中です。少し待ってから、もう一度「送る」を押してください'); return; }
      send.disabled = true; say('送っています…');
      try {
        const r = await fetch(form.dataset.api!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...body, turnstile: token }), credentials: 'omit', referrerPolicy: 'no-referrer' });
        const d = await r.json().catch(() => ({}));
        if (r.ok && d.ok) { form.reset(); say('ありがとうございます！確認してから載せます。', true); }
        else say(d.error || '送れませんでした。時間をおいて、もう一度お試しください');
      } catch { say('送れませんでした。電波のよいところで、もう一度お試しください'); }
      finally {
        send.disabled = false; token = '';
        try { (window as any).turnstile?.reset(widget); } catch { /* 次の送信で確認し直す */ }
      }
    });
  }
</script>
