{
  "name": "tegevajaro-stats",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:test": "PUBLIC_TEGESTA_TEST=1 astro build",
    "deploy:test": "PUBLIC_TEGESTA_TEST=1 astro build && cd test-site && npx wrangler@4.150.0 pages deploy ../dist-test --project-name test-tegesta --branch main",
    "test:pull": "sh tools/pull_test.sh",
    "preview": "astro preview",
    "test": "node --test tests/*.test.js worker/test/*.test.js",
    "roster": "node tools/check_roster.mjs",
    "spots:pull": "sh tools/pull_spots.sh",
    "links:pull": "sh tools/pull_links.sh",
    "suki:pull": "sh tools/pull_suki.sh",
    "removals:pull": "sh tools/pull_removals.sh",
    "spots:names": "node tools/spot_names.mjs",
    "snapshot": "node tools/rank_snapshot.mjs"
  },
  "dependencies": {
    "astro": "7.4.5",
    "budoux": "0.10.2",
    "canvas-confetti": "1.9.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "satori": "0.63.2"
  },
  "overrides": {
    "fflate": "0.8.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
